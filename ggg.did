// GGG 0.1.0: the GGG model in Candid.
// Model: https://github.com/smart-social-contracts/ggg/blob/main/model/README.md
//
// One record per model entity, with the model's fields, and one method per model operation.
// Every entity is here; the methods cover the operations bound so far.

// ---- Conventions (model §1)

// Nanoseconds since 1970-01-01 UTC, as returned by ic0.time.
type Timestamp = nat64;
// Nanoseconds.
type Duration = nat64;

// The ICRC-3 generic value, for structured data whose shape the model leaves open.
type Value = variant {
  Nat : nat;
  Int : int;
  Text : text;
  Blob : blob;
  Array : vec Value;
  Map : vec record { text; Value };
};

// A reference to any entity: `kind` is the entity's name in the model.
type Ref = record { kind : text; id : text };

type GggError = variant {
  NotFound;
  Unauthenticated;
  Forbidden : record { permission : opt text; message : text };
  InvalidArgument : text;
  Conflict : text;
  Unavailable : text;
  GenericError : record { error_code : nat; message : text };
};

// ---- §2 Identity and membership

type User = record {
  id : principal;
  nickname : opt text;
  avatar : opt text;
  home_quarter : opt text;
  profiles : vec text;
  private_data : opt blob;
};

type MemberStatus = variant { Active; Inactive; Suspended; Banned };

type Member = record {
  id : text;
  user : principal;
  status : MemberStatus;
  joined_at : opt Timestamp;
};

type GuestUser = record {
  id : principal;
  home_quarter : text;
  permissions : vec text;
};

type Human = record {
  id : text;
  user : principal;
  date_of_birth : opt Timestamp;
  h3_index : opt text;
};

type IdentityStatus = variant { Pending; Verified; Rejected };

type Identity = record {
  id : text;
  human : text;
  kind : text;
  issuer : text;
  ref : text;
  status : IdentityStatus;
  verified_at : opt Timestamp;
};

type UserProfile = record {
  id : text;
  description : text;
  allowed_to : vec text;
  permissions : vec text;
};

type Permission = record {
  id : text;
  description : text;
  category : text;
  scope : opt text;
  users : vec principal;
  profiles : vec text;
  departments : vec text;
};

type Invite = record {
  id : text;
  profile : opt text;
  department : opt text;
  position : opt text;
  max_uses : nat;
  uses : nat;
  redeemed_by : vec principal;
  expires_at : opt Timestamp;
  revoked : bool;
  created_by : principal;
};

type DelegationStatus = variant { Pending; Active; Revoked; Expired; Declined };

type Delegation = record {
  id : text;
  grantor : principal;
  delegate : principal;
  scope : vec text;
  status : DelegationStatus;
  label : text;
  description : text;
  requires_acceptance : bool;
  granted_by : principal;
  accepted_at : opt Timestamp;
  starts_at : opt Timestamp;
  expires_at : Timestamp;
  revoked_at : opt Timestamp;
  revoked_by : opt principal;
};

type DelegationRequest = record {
  id : text;
  grantor : principal;
  delegate : principal;
  scope : vec text;
  label : text;
  description : text;
  starts_at : opt Timestamp;
  expires_at : Timestamp;
  request_expires_at : Timestamp;
};

// ---- §3 Departments and organizations

// m of n approvals; quorum in basis points.
type Policy = record { m : nat; n : nat; quorum : nat; veto : vec principal };

type Department = record {
  id : text;
  description : text;
  parent : opt text;
  is_root : bool;
  head : opt principal;
  policy : Policy;
  target_policy : opt Policy;
  fund : opt text;
};

type OrganizationStatus = variant { Active; Suspended; Dissolved };

type Organization = record {
  id : text;
  description : text;
  status : OrganizationStatus;
  admins : vec principal;
};

type PositionStatus = variant { Open; Frozen; Closed };

type Position = record {
  id : text;
  department : opt text;
  organization : opt text;
  title : text;
  profile : opt text;
  headcount : nat;
  salary : nat;
  salary_period : opt Duration;
  status : PositionStatus;
  inherit_from_capital : bool;
};

type AppointmentKind = variant { Substantive; Acting };
type AppointmentStatus = variant { Active; Ended };

type Appointment = record {
  id : text;
  position : text;
  user : principal;
  kind : AppointmentKind;
  agent : bool;
  supervisor : opt principal;
  started_at : Timestamp;
  ended_at : opt Timestamp;
  status : AppointmentStatus;
  source_quarter : opt text;
};

type Authority = record {
  id : text;
  grantor : text;
  target : Ref;
  operations : vec text;
};

// ---- §4 Governance

type ProposalStatus = variant { Draft; Voting; Accepted; Rejected; Expired; Executed; Failed; Withdrawn };

type ProposalAction = variant {
  // The decision itself is the outcome.
  Motion;
  // One update call the realm makes to itself once accepted; `arg` is Candid-encoded.
  Call : record { method : text; arg : blob };
  // Codex code to adopt; checksum is "sha256:<hex>".
  Code : record { url : text; checksum : text };
};

type ProposalResult = variant {
  // The Candid-encoded reply of a Call.
  Reply : blob;
  // Why execution failed.
  Error : text;
};

type Tally = record { yes : nat; no : nat; abstain : nat; eligible : opt nat };

type Proposal = record {
  id : text;
  title : text;
  description : text;
  proposer : principal;
  on_behalf_of : opt principal;
  department : opt text;
  action : ProposalAction;
  status : ProposalStatus;
  opens_at : opt Timestamp;
  deadline : opt Timestamp;
  threshold : nat;
  quorum : nat;
  tally : Tally;
  result : opt ProposalResult;
};

type VoteChoice = variant { Yes; No; Abstain };

type Vote = record {
  id : text;
  proposal : text;
  voter : principal;
  cast_by : opt principal;
  choice : VoteChoice;
  cast_at : Timestamp;
};

type MandateStatus = variant { Active; Completed; Revoked; Expired };

type Mandate = record {
  id : text;
  title : text;
  scope : Value;
  max_value : opt nat;
  symbol : opt text;
  executor : opt text;
  proposal : opt text;
  status : MandateStatus;
  expires_at : opt Timestamp;
};

type ContractStatus = variant { Draft; Active; Fulfilled; Terminated; Disputed };

type Contract = record {
  id : text;
  title : text;
  parties : vec Ref;
  mandate : opt text;
  value : nat;
  symbol : text;
  terms_ref : text;
  terms_hash : text;
  status : ContractStatus;
  starts_at : opt Timestamp;
  ends_at : opt Timestamp;
};

// ---- §5 Finance

type TreasuryConfig = record {
  epoch : Duration;
  anchor_month : nat8;
  source_fund : text;
  auto_allocate : bool;
};

type Treasury = record { id : text; config : TreasuryConfig };

type Token = record {
  id : text;
  ledger : principal;
  indexer : opt principal;
  decimals : nat8;
  fee : nat;
};

type NFTToken = record {
  id : text;
  canister : principal;
  name : text;
  description : text;
  transferable : bool;
  required_license : opt text;
  supply_cap : opt nat;
  total_supply : nat;
};

type Balance = record { symbol : text; amount : nat };

type Fund = record {
  id : text;
  name : text;
  kind : text;
  department : opt text;
  balances : vec Balance;
  allocation_rule : opt text;
};

type FiscalPeriodStatus = variant { Open; Closed; Archived };

type FiscalPeriod = record {
  id : text;
  name : text;
  starts_at : Timestamp;
  ends_at : Timestamp;
  status : FiscalPeriodStatus;
  statements : Value;
  source_hash : text;
};

type BudgetStatus = variant { Draft; Proposed; Adopted; Amended; Closed };

type Budget = record {
  id : text;
  fund : text;
  period : text;
  category : text;
  kind : text;
  planned : nat;
  actual : nat;
  status : BudgetStatus;
  proposal : opt text;
};

// AllocationRule and TaxPolicy.
type AdoptionStatus = variant { Draft; Proposed; Adopted; Superseded };

// share in basis points.
type Allocation = record { fund : text; share : nat };

type AllocationRule = record {
  id : text;
  source_fund : text;
  rules : vec Allocation;
  status : AdoptionStatus;
  proposal : opt text;
};

type LedgerKind = variant { Asset; Liability; Equity; Revenue; Expense };

// At most one of the source references (transfer … appeal) is set.
type LedgerEntry = record {
  id : text;
  transaction : text;
  kind : LedgerKind;
  category : text;
  debit : nat;
  credit : nat;
  symbol : text;
  fund : opt text;
  period : opt text;
  transfer : opt text;
  invoice : opt text;
  user : opt principal;
  organization : opt text;
  contract : opt text;
  case : opt text;
  penalty : opt text;
  appeal : opt text;
  at : Timestamp;
  description : text;
};

type InvoiceStatus = variant { Pending; Paid; Overdue; Cancelled };

type Invoice = record {
  id : text;
  payer : Ref;
  amount : nat;
  symbol : text;
  due_at : opt Timestamp;
  status : InvoiceStatus;
  reason : opt Ref;
  paid_at : opt Timestamp;
  payment : opt Value;
};

type TransferStatus = variant { Sending; Pending; Completed; Failed };

type Transfer = record {
  id : text;
  sender : Ref;
  to : Ref;
  symbol : text;
  amount : nat;
  ledger_tx : opt nat;
  invoice : opt text;
  status : TransferStatus;
  at : Timestamp;
  payroll : opt text;
};

type TradeStatus = variant { Pending; Completed; Failed };

type Trade = record {
  id : text;
  contract : opt text;
  leg_a : text;
  leg_b : text;
  status : TradeStatus;
};

type PaymentAccount = record {
  id : text;
  owner : Ref;
  network : text;
  address : text;
  symbol : text;
  label : text;
  verified : bool;
};

type FinancialReport = record {
  id : text;
  kind : text;
  period : text;
  as_of : Timestamp;
  statements : Value;
  source_hash : text;
  issued_by : principal;
  supersedes : opt text;
};

type TaxPolicy = record {
  id : text;
  status : AdoptionStatus;
  document : Value;
  description : text;
  proposal : opt text;
  adopted_at : opt Timestamp;
};

type TaxDeclarationStatus = variant { Filed; Assessed; Settled; Disputed };

type TaxDeclaration = record {
  id : text;
  declarant : Ref;
  period : text;
  base : text;
  amount : nat;
  status : TaxDeclarationStatus;
  invoice : opt text;
};

// ---- §6 Assets

type LandStatus = variant { Active; Disputed; Revoked };

type Land = record {
  id : text;
  x : nat;
  y : nat;
  width : nat;
  height : nat;
  kind : text;
  owner : Ref;
  status : LandStatus;
  token_id : opt nat;
  registered_by : principal;
  metadata : Value;
};

type Zone = record {
  id : text;
  name : text;
  kind : text;
  land : opt text;
  user : opt principal;
  metadata : Value;
};

// ---- §7 Licensing

type LicenseStatus = variant { Applied; Active; Rejected; Suspended; Revoked; Expired };

type License = record {
  id : text;
  kind : text;
  holder : Ref;
  issued_by : text;
  status : LicenseStatus;
  applied_at : Timestamp;
  issued_at : opt Timestamp;
  expires_at : opt Timestamp;
  evidence_ref : opt text;
  conditions : Value;
};

// ---- §8 Justice

type CourtLevel = variant { FirstInstance; Appellate; Supreme; Specialized };
type CourtStatus = variant { Active; Closed };

type Court = record {
  id : text;
  name : text;
  operator : Ref;
  level : CourtLevel;
  jurisdiction : text;
  parent : opt text;
  status : CourtStatus;
  license : opt text;
};

type JudgeStatus = variant { Active; Revoked };

type Judge = record {
  id : text;
  user : principal;
  court : text;
  specialization : text;
  status : JudgeStatus;
  appointed_at : Timestamp;
};

type DisputeStatus = variant { Filed; Accepted; Rejected; Withdrawn };

type Dispute = record {
  id : text;
  claimant : principal;
  respondent : Ref;
  subject : opt Ref;
  title : text;
  description_ref : opt text;
  status : DisputeStatus;
  case : opt text;
};

type CaseStatus = variant { Filed; Assigned; InProgress; VerdictIssued; Appealed; Closed; Dismissed; Transferred };

// Encrypted content: where it lives and its hash.
type Sealed = record { ref : text; hash : text };

type Case = record {
  id : text;
  court : text;
  plaintiff : Ref;
  defendant : Ref;
  judges : vec text;
  title : text;
  dispute : opt text;
  evidence : vec Sealed;
  status : CaseStatus;
  filed_at : Timestamp;
  closed_at : opt Timestamp;
};

type VerdictStatus = variant { Draft; Issued; Final; Overturned };

type Verdict = record {
  id : text;
  case : text;
  issued_by : text;
  decision : text;
  reasoning_ref : opt text;
  status : VerdictStatus;
  contract : opt text;
  issued_at : opt Timestamp;
};

type AppealStatus = variant { Filed; UnderReview; Granted; Denied; Withdrawn };

type Appeal = record {
  id : text;
  case : text;
  verdict : text;
  court : text;
  appellant : principal;
  grounds_ref : opt text;
  status : AppealStatus;
  decision : opt text;
  new_verdict : opt text;
};

type PenaltyKind = variant {
  Fine;
  Restitution;
  CommunityService;
  Suspension;
  Revocation;
  Injunction;
  Freeze;
  Termination;
};

type PenaltyStatus = variant { Pending; Executed; Waived };

type Penalty = record {
  id : text;
  verdict : text;
  target : Ref;
  kind : PenaltyKind;
  amount : opt nat;
  symbol : opt text;
  status : PenaltyStatus;
  due_at : opt Timestamp;
  executed_at : opt Timestamp;
  invoice : opt text;
};

// ---- §9 Procurement

type TenderStatus = variant { Draft; Open; Closed; Evaluation; Awarded; Contracted; Cancelled };

// weight in basis points.
type Criterion = record { criterion : text; weight : nat };

type Tender = record {
  id : text;
  title : text;
  description : text;
  requester : text;
  status : TenderStatus;
  opens_at : opt Timestamp;
  closes_at : opt Timestamp;
  rubric : vec Criterion;
  winner : opt text;
  contract : opt text;
};

type Bid = record {
  id : text;
  tender : text;
  vendor : text;
  submitted_at : Timestamp;
  sealed : bool;
  payload_ref : text;
  payload_hash : text;
  price : opt nat;
  score : opt nat;
};

type BidScore = record {
  id : text;
  bid : text;
  evaluator : principal;
  criterion : text;
  score : nat;
  scored_at : Timestamp;
};

// ---- §10 Quarters and federation

type RealmStatus = variant { Setup; Alpha; Beta; Production; Deprecation; Terminated };

type Realm = record {
  id : text;
  name : text;
  manifesto : text;
  welcome_message : text;
  status : RealmStatus;
  calendar : opt text;
  treasury : opt text;
  accounting_currency : opt text;
  accounting_currency_decimals : opt nat8;
  is_quarter : bool;
  is_capital : bool;
  federation_realm_id : opt text;
  federation_codex : opt text;
  quarter_join_mode : opt text;
  trusted_principals : vec principal;
  require_marketplace_approval : bool;
  trusted_approvers : vec text;
  voting_threshold : nat;
  voting_quorum : nat;
  open_registration : bool;
  logo_url : opt text;
  background_image_url : opt text;
  installed_version : text;
  network : text;
};

type Cycle = record { name : text; every : Duration };

type Calendar = record {
  id : text;
  realm : text;
  epoch : Duration;
  fiscal_period : Duration;
  voting_window : Duration;
  codex_release_cycle : opt Duration;
  benefit_cycle : opt Duration;
  service_payment_cycle : opt Duration;
  license_review_cycle : opt Duration;
  custom_cycles : vec Cycle;
};

type Registry = record { id : text; description : text; principal_id : principal };

type QuarterStatus = variant { Setup; Active; Suspended; Splitting; Merging };

type Quarter = record {
  id : text;
  name : text;
  index : nat;
  status : QuarterStatus;
  population : nat;
  codex_id : opt text;
  codex_version : opt text;
  last_sync : opt Timestamp;
  last_activity_at : opt Timestamp;
};

type Forward = record {
  id : text;
  subject : Ref;
  origin : text;
  destination : text;
  moved_at : Timestamp;
  signature : blob;
};

type FederalVoteStatus = variant { Open; Passed; Failed; Cancelled };

type FederalVote = record {
  id : text;
  title : text;
  origin_quarter : text;
  action : ProposalAction;
  rule : Value;
  hash : text;
  deadline : Timestamp;
  status : FederalVoteStatus;
  tally : Value;
};

type FederalVoteLegStatus = variant { Open; Reported };
type Outcome = variant { Passed; Failed };

type FederalVoteLeg = record {
  id : text;
  vote : text;
  quarter : text;
  proposal_id : opt text;
  outcome : opt Outcome;
  yes : nat;
  no : nat;
  abstain : nat;
  eligible : nat;
  status : FederalVoteLegStatus;
  hash : opt text;
};

type FederationMessage = record {
  id : text;
  topic : text;
  source : text;
  body : Value;
  response : opt Value;
};

// ---- §11 Codex, notifications and audit

type CodexStatus = variant { Active; Inactive; Reverted };

type Codex = record {
  id : text;
  version : text;
  checksum : text;
  status : CodexStatus;
  manifest : Value;
  capabilities : vec text;
  source : text;
  installed_at : Timestamp;
  previous : opt text;
};

type Notification = record {
  id : text;
  recipient : Ref;
  topic : text;
  title : text;
  body : text;
  href : opt text;
  sender : opt text;
  visibility : text;
  read_by : vec principal;
  at : Timestamp;
};

type Event = record {
  id : text;
  op : text;
  user : opt principal;
  by : opt principal;
  agent : bool;
  supervisor : opt principal;
  origin : text;
  args : Value;
  result : Value;
  at : Timestamp;
};

// ---- §13 Private content

type KeyEnvelope = record {
  id : text;
  scope : text;
  "principal" : principal;
  wrapped_dek : blob;
  granted_by : principal;
  at : Timestamp;
};

type Document = record {
  id : text;
  department : text;
  title : text;
  ref : text;
  hash : text;
  author : principal;
  at : Timestamp;
};

// ---- Operation arguments and results

type ListArgs = record { cursor : opt text; limit : opt nat32 };
// One record by id, with its children a page at a time.
type GetArgs = record { id : text; cursor : opt text; limit : opt nat32 };

// The change was applied, with the id of any record it created, or a proposal was filed to make it.
type Governed = variant { Done : opt text; Proposed : text };

// §2

type UserEntry = record { user : User; member : opt Member };
type UserPage = record { items : vec UserEntry; next : opt text };
type InvitePage = record { items : vec Invite; next : opt text };

type DelegationListArgs = record {
  role : variant { Grantor; Delegate };
  cursor : opt text;
  limit : opt nat32;
};
// The caller's delegations in that role, and its open requests either way.
type DelegationPage = record { items : vec Delegation; requests : vec DelegationRequest; next : opt text };

type DelegableOperation = record { operation : text; permission : text };

type JoinArgs = record { code : opt text; nickname : opt text };
type ProfileUpdateArgs = record { nickname : opt text; avatar : opt text; on_behalf_of : opt principal };

type NewUser = record { user : principal; nickname : opt text };
type UserAddArgs = record { user : principal; nickname : opt text; department : opt text };
// At most 500 users per call. Nobody is added if one is already known or listed twice.
type UserImportArgs = record { users : vec NewUser; department : opt text };
type UserEditArgs = record { user : principal; nickname : opt text; avatar : opt text; home_quarter : opt text };
type UserSetStatusArgs = record { user : principal; status : MemberStatus; department : opt text };
type UserRemoveArgs = record { user : principal; department : opt text };

type IdentitySubmitArgs = record { kind : text; issuer : opt text; ref : text; on_behalf_of : opt principal };
type IdentityReviewArgs = record { identity : text; status : variant { Verified; Rejected } };

type InviteCreateArgs = record {
  profile : opt text;
  department : opt text;
  position : opt text;
  code : opt text;
  max_uses : opt nat;
  expires_at : opt Timestamp;
};
// The code is returned only this once.
type InviteCreated = record { invite : Invite; code : text };

type ProfileCreateArgs = record { profile : text; description : text; allowed_to : vec text; department : opt text };
type ProfileEditArgs = record {
  profile : text;
  description : opt text;
  allowed_to : opt vec text;
  department : opt text;
};
type RoleArgs = record { user : principal; profile : text; department : opt text };

type DelegationGrantArgs = record {
  delegate : principal;
  scope : vec text;
  starts_at : opt Timestamp;
  expires_at : Timestamp;
  label : text;
  description : text;
};
type DelegationRequestArgs = record {
  grantor : principal;
  scope : vec text;
  starts_at : opt Timestamp;
  expires_at : Timestamp;
  label : text;
  description : text;
};
// Approving may narrow the scope or end the grant earlier.
type DelegationDecideArgs = record {
  request : text;
  approve : bool;
  scope : opt vec text;
  expires_at : opt Timestamp;
};

// §3

// A position and the appointments that hold it.
type Seat = record { position : Position; holders : vec Appointment };

type DepartmentDetail = record { department : Department; seats : vec Seat; next : opt text };
type DepartmentPage = record { items : vec Department; next : opt text };

type ChartArgs = record { department : opt text; cursor : opt text; limit : opt nat32 };
// One level of the chart: the department's totals, and its sub-departments a page at a time.
type Chart = record {
  department : Department;
  positions : nat;
  seats : nat;
  filled : nat;
  children : vec Department;
  next : opt text;
};

type OrganizationDetail = record { organization : Organization; seats : vec Seat; next : opt text };
type OrganizationListArgs = record { cursor : opt text; limit : opt nat32; status : opt OrganizationStatus };
type OrganizationPage = record { items : vec Organization; next : opt text };

type DepartmentCreateArgs = record { department : text; parent : opt text; description : text };
// The parent is never the department itself or one of its sub-departments; the root has none.
type DepartmentEditArgs = record {
  department : text;
  description : opt text;
  parent : opt text;
  head : opt variant { Set : principal; Clear };
};
type DepartmentPolicyArgs = record { department : text; policy : Policy };

type PositionCreateArgs = record {
  department : text;
  position : text;
  title : text;
  headcount : opt nat;
  salary : opt nat;
  salary_period : opt Duration;
  profile : opt text;
};
// Closing is position_close.
type PositionEditArgs = record {
  position : text;
  status : opt variant { Open; Frozen };
  headcount : opt nat;
  title : opt text;
  salary : opt nat;
  salary_period : opt Duration;
  profile : opt text;
};

// An agent needs a supervisor holding a non-agent seat in the same department or organization.
type AppointArgs = record { position : text; user : principal; agent : bool; supervisor : opt principal };
type ExpelArgs = record { department : text; user : principal };
type AuthorityGrantArgs = record { department : text; target : Ref; operations : vec text };

type OrganizationRegisterArgs = record { organization : text; description : text };
type OrganizationEditArgs = record { organization : text; description : opt text; admins : opt vec principal };
// Seats the user in the organization's position, creating the position if it is new.
type RepresentativeAddArgs = record {
  organization : text;
  position : text;
  user : principal;
  agent : bool;
  supervisor : opt principal;
  title : opt text;
  profile : opt text;
  headcount : opt nat;
};
type OrganizationStatusArgs = record { organization : text; status : OrganizationStatus };

// §4

// The proposal, and its votes a page at a time.
type ProposalDetail = record { proposal : Proposal; votes : vec Vote; next : opt text };

type ProposalListArgs = record { cursor : opt text; limit : opt nat32; status : opt ProposalStatus };
type ProposalPage = record { items : vec Proposal; next : opt text };

type ProposalCreateArgs = record {
  title : text;
  description : text;
  department : opt text;
  action : ProposalAction;
  on_behalf_of : opt principal;
};

type ProposalVoteArgs = record {
  proposal : text;
  choice : VoteChoice;
  on_behalf_of : opt principal;
};

type ProposalWithdrawArgs = record { proposal : text; on_behalf_of : opt principal };

// A replayed proposal records itself as the mandate's proposal.
type MandateCreateArgs = record {
  title : text;
  scope : Value;
  max_value : opt nat;
  symbol : opt text;
  executor : opt text;
  expires_at : opt Timestamp;
};
type MandateRevokeArgs = record { mandate : text };
type MandateExecutorArgs = record { mandate : text; executor : text };

type ContractCreateArgs = record {
  title : text;
  parties : vec Ref;
  mandate : opt text;
  value : nat;
  symbol : text;
  terms_ref : text;
  terms_hash : text;
  starts_at : opt Timestamp;
  ends_at : opt Timestamp;
};

type GovernanceUpdateArgs = record {
  voting_window : opt Duration;
  voting_threshold : opt nat;
  voting_quorum : opt nat;
};

// §5

// The treasury and its registered tokens, and its funds a page at a time.
type TreasuryView = record {
  treasury : opt Treasury;
  tokens : vec Token;
  nft_tokens : vec NFTToken;
  funds : vec Fund;
  next : opt text;
};

type LedgerArgs = record {
  cursor : opt text;
  limit : opt nat32;
  transaction : opt text;
  symbol : opt text;
  kind : opt LedgerKind;
  fund : opt text;
  period : opt text;
};
type LedgerPage = record { items : vec LedgerEntry; next : opt text };

// One report by id, or a page of reports.
type ReportArgs = record { id : opt text; cursor : opt text; limit : opt nat32 };
type ReportPage = record { items : vec FinancialReport; next : opt text };

// An ICRC-1 account.
type Account = record { owner : principal; subaccount : opt blob };

type TreasuryConfigureArgs = record {
  epoch : opt Duration;
  anchor_month : opt nat8;
  source_fund : opt text;
  auto_allocate : opt bool;
};
type TokenRegisterArgs = record {
  symbol : text;
  ledger : principal;
  indexer : opt principal;
  decimals : opt nat8;
  fee : opt nat;
};
type NFTTokenRegisterArgs = record {
  symbol : text;
  canister : principal;
  name : opt text;
  description : opt text;
  transferable : opt bool;
  required_license : opt text;
  supply_cap : opt nat;
};

// The fund must also cover the ledger fee. `symbol` defaults to the accounting currency.
type TransferCreateArgs = record {
  fund : text;
  to : Ref;
  amount : nat;
  symbol : opt text;
  category : opt text;
  description : opt text;
  contract : opt text;
  on_behalf_of : opt principal;
};
type TransferRevertArgs = record { transfer : text; reason : opt text };

type InvoiceCreateArgs = record {
  payer : Ref;
  amount : nat;
  symbol : opt text;
  due_at : opt Timestamp;
  reason : opt Ref;
};
// The invoice, and the account to pay it into.
type InvoiceCreated = record { invoice : Invoice; pay_to : Account };
type InvoiceCheckArgs = record { invoice : text; on_behalf_of : opt principal };
// One invoice, or a batch of the pending and overdue ones (at most 20 per call).
type InvoiceRefreshArgs = record { invoice : opt text; cursor : opt text; limit : opt nat32 };
type InvoicePage = record { items : vec Invoice; next : opt text };

// `department` is the fund's owner; a department owns at most one fund.
type FundCreateArgs = record { fund : text; name : opt text; kind : opt text; department : opt text };
// Periods open in order: one starts no earlier than the latest ends.
type PeriodOpenArgs = record { period : text; name : opt text; starts_at : Timestamp; ends_at : Timestamp };
type BudgetDraftArgs = record { fund : text; period : text; category : text; kind : opt text; planned : nat };
type BudgetAmendArgs = record { budget : text; planned : nat };
// Shares in basis points, adding up to at most 10 000.
type AllocationRuleDraftArgs = record { source_fund : text; rules : vec Allocation };
// Pays each active, non-agent appointee once per period label.
type PayrollRunArgs = record { department : text; period : text; symbol : opt text };
type ReportIssueArgs = record { period : text; kind : opt text };

type TaxPolicyDraftArgs = record { document : Value; description : opt text };
// Bills one batch of taxpayers for the period; those already billed are skipped.
type TaxAssessArgs = record { period : text; tax : opt text; cursor : opt text; limit : opt nat32 };
type TaxAssessPage = record { items : vec Invoice; skipped : nat; next : opt text };
// For the caller, or an organization they administer.
type TaxDeclareArgs = record {
  base : text;
  period : text;
  amount : nat;
  organization : opt text;
  on_behalf_of : opt principal;
};
type TaxDeclared = record { declaration : TaxDeclaration; invoice : opt Invoice };

type PaymentAccountAddArgs = record {
  network : text;
  address : text;
  symbol : opt text;
  label : opt text;
  organization : opt text;
  on_behalf_of : opt principal;
};
type PaymentAccountRemoveArgs = record { account : text; organization : opt text; on_behalf_of : opt principal };

// By court order.
type ForceTransferArgs = record { symbol : text; from : principal; to : principal; amount : nat; reason : opt text };
type FreezeArgs = record { symbol : text; account : principal; frozen : bool; reason : opt text };

// §6

type LandListArgs = record { cursor : opt text; limit : opt nat32; owner : opt Ref };
type LandPage = record { items : vec Land; next : opt text };

// A viewport of at most 32 × 32 cells, and the zones not tied to a parcel a page at a time.
type LandMapArgs = record { x : nat; y : nat; w : nat; h : nat; cursor : opt text; limit : opt nat32 };
type LandMap = record { parcels : vec Land; zones : vec Zone; next : opt text };

// The token's ggg: header as read from the ledger, and its frozen flag.
type CredentialVerifyArgs = record { header : vec record { text; text }; frozen : bool };
type CredentialCheck = record { valid : bool; ours : bool; licensed : bool; expired : bool; revoked : bool };

// At most 16 × 16 cells, overlapping no other parcel.
type LandRegisterArgs = record {
  x : nat;
  y : nat;
  width : opt nat;
  height : opt nat;
  owner : Ref;
  kind : opt text;
  metadata : opt Value;
};
// Under a court order: an issued or final verdict in a case about the parcel, with `to` a party.
type LandTransferArgs = record { land : text; to : Ref; order : text };
type LandMintArgs = record { land : text; prepared_by : opt principal };
type LandFreezeArgs = record { land : text; reason : opt text };

// An h3 cell as the caller's home; it replaces the previous one.
type ZoneSetArgs = record { zone : text; name : opt text; kind : opt text; on_behalf_of : opt principal };
type ZoneClearArgs = record { zone : text; on_behalf_of : opt principal };

type CredentialIssueArgs = record {
  schema : text;
  holder : principal;
  organization : text;
  subject : opt text;
  fields : vec record { text; text };
  payload_hash : opt text;
  payload_ref : opt text;
  prepared_by : opt principal;
  expires_at : opt Timestamp;
};
type CredentialIssued = record { token_id : nat; header : vec record { text; text } };
type CredentialRevokeArgs = record { schema : text; token_id : nat; organization : text; reason : text };

// §7

type LicenseListArgs = record {
  cursor : opt text;
  limit : opt nat32;
  holder : opt Ref;
  kind : opt text;
  status : opt LicenseStatus;
};
type LicensePage = record { items : vec License; next : opt text };

// A licence by id, or the one of `kind` that `holder` holds.
type LicenseVerifyArgs = record { id : opt text; holder : opt Ref; kind : opt text };
type LicenseCheck = record { valid : bool; license : opt License };

// For the caller, or an organization they administer.
type LicenseApplyArgs = record {
  kind : text;
  holder : opt Ref;
  department : opt text;
  evidence_ref : opt text;
  conditions : opt Value;
  on_behalf_of : opt principal;
};
type LicenseRenewArgs = record { license : text; evidence_ref : opt text; on_behalf_of : opt principal };
type LicenseDecideArgs = record {
  license : text;
  approve : bool;
  department : opt text;
  expires_at : opt Timestamp;
  conditions : opt Value;
};
// With `resume`, reinstates a suspended licence.
type LicenseSuspendArgs = record { license : text; resume : bool };

// §8

type DisputeGetArgs = record { id : text; on_behalf_of : opt principal };
type DisputeListArgs = record { cursor : opt text; limit : opt nat32; status : opt DisputeStatus };
type DisputePage = record { items : vec Dispute; next : opt text };

// Verdicts past draft, newest first.
type ResolutionQueryArgs = record {
  cursor : opt text;
  limit : opt nat32;
  since : opt Timestamp;
  court : opt text;
  search : opt text;
};
type Resolution = record { verdict : Verdict; penalties : vec Penalty };
type ResolutionPage = record { items : vec Resolution; next : opt text };

type DisputeFileArgs = record {
  title : text;
  respondent : Ref;
  subject : opt Ref;
  description_ref : opt text;
  on_behalf_of : opt principal;
};
type DisputeWithdrawArgs = record { dispute : text; on_behalf_of : opt principal };
type DisputeAcceptArgs = record { dispute : text; court : text };
type CaseAssignArgs = record { case : text; judge : text };
type EvidenceSubmitArgs = record { case : text; ref : text; hash : text; on_behalf_of : opt principal };
type EvidenceEvaluateArgs = record { case : text; evidence : text; admitted : bool };

type PenaltyTerms = record {
  kind : PenaltyKind;
  target : Ref;
  amount : opt nat;
  symbol : opt text;
  due_at : opt Timestamp;
};
type VerdictDraftArgs = record { case : text; decision : text; reasoning_ref : opt text; penalties : vec PenaltyTerms };
type VerdictContractArgs = record { verdict : text; contract : text };
// New penalties replace them all. Changing an issued verdict restarts its appeal window.
type VerdictTermsArgs = record {
  verdict : text;
  decision : opt text;
  reasoning_ref : opt text;
  penalties : opt vec PenaltyTerms;
};
// `court` defaults to the issuing court's parent, and must rank above it.
type AppealFileArgs = record { verdict : text; court : opt text; grounds_ref : opt text; on_behalf_of : opt principal };
// Granting issues a new verdict that overturns the appealed one.
type AppealDecideArgs = record {
  appeal : text;
  granted : bool;
  decision : opt text;
  reasoning_ref : opt text;
  penalties : vec PenaltyTerms;
};
type PenaltyExecuteArgs = record { penalty : text; due_at : opt Timestamp };
type EnforcementArgs = record { verdict : text; note : text };
type EnforcementNotifyArgs = record { verdict : text; to : Ref; title : opt text; body : opt text };

// `operator` is a department, or an organization holding an active court licence.
type CourtCreateArgs = record {
  name : text;
  operator : Ref;
  level : opt CourtLevel;
  jurisdiction : opt text;
  parent : opt text;
};
type JudgeAppointArgs = record { court : text; user : principal; specialization : opt text };

// §9

type TenderListArgs = record { cursor : opt text; limit : opt nat32; status : opt TenderStatus };
type TenderPage = record { items : vec Tender; next : opt text };
// A sealed bid shows no price or score.
type TenderDetail = record { tender : Tender; bids : vec Bid; next : opt text };

// Weights in basis points, adding up to 10 000.
type TenderCreateArgs = record {
  requester : text;
  title : text;
  description : opt text;
  opens_at : opt Timestamp;
  closes_at : opt Timestamp;
  rubric : vec Criterion;
};
// For a vendor the caller represents. `payload_hash` is the sha256 of `price:nonce`.
type BidSubmitArgs = record {
  tender : text;
  vendor : text;
  payload_ref : text;
  payload_hash : text;
  on_behalf_of : opt principal;
};
type BidWithdrawArgs = record { bid : text; on_behalf_of : opt principal };
type BidOpening = record { bid : text; price : nat; nonce : text };
type BidsRevealArgs = record { tender : text; openings : vec BidOpening };
// Marks from 0 to 10 per rubric criterion; scoring again replaces the caller's marks.
type BidScoreArgs = record { bid : text; scores : vec record { criterion : text; score : nat } };
// `bid` defaults to the best-scored revealed bid; a lower-scored one needs a justification.
type TenderAwardArgs = record { tender : text; bid : opt text; justification : opt text };

// §10

type QuarterDirectory = record { capital : opt text; items : vec Quarter; next : opt text };

type QuarterRegisterArgs = record { canister : principal; name : opt text };
type QuarterConfigureArgs = record {
  quarter : opt text;
  name : opt text;
  status : opt QuarterStatus;
  quarter_join_mode : opt text;
  federation_codex : opt text;
  rule : opt Value;
};
type JoinFederationArgs = record { capital : principal; name : opt text };
type ChangeQuarterArgs = record { quarter : text; on_behalf_of : opt principal };
type FederalVoteProposeArgs = record { title : text; action : ProposalAction; on_behalf_of : opt principal };
// To quarter `to`, or by default every active quarter.
type FederationMessageArgs = record { topic : text; body : Value; to : opt text };

// §11

type SigningPolicy = record {
  agents : vec text;
  delegable : vec text;
  supervision : variant { Required; Optional };
};

// The active codex and a page of earlier ones, each named by its checksum ("sha256:<hex>").
// No method returns a Codex record.
type CodexView = record {
  checksum : opt text;
  healthy : bool;
  signing : SigningPolicy;
  history : vec text;
  next : opt text;
};

type NotificationListArgs = record {
  recipient : opt Ref;
  unread : opt bool;
  cursor : opt text;
  limit : opt nat32;
  on_behalf_of : opt principal;
};
type NotificationPage = record { items : vec Notification; next : opt text };

// Newest first. An archive holds the events from `first` to `last`, and answers ggg_events for them.
type EventArchive = record { canister : principal; first : text; last : text };
type EventPage = record { items : vec Event; next : opt text; archives : vec EventArchive };

type CodexSource = variant {
  Package : record { manifest : Value; source : text };
  Registry : record { codex : text; version : text };
};
// One notification, or with `recipient` a page of that recipient's.
type NotificationReadArgs = record {
  notification : opt text;
  recipient : opt Ref;
  cursor : opt text;
  limit : opt nat32;
  on_behalf_of : opt principal;
};
type NotificationsRead = record { read : nat; next : opt text };
type NotificationSendArgs = record {
  recipient : Ref;
  title : text;
  body : opt text;
  href : opt text;
  topic : opt text;
};

// §12

type RealmConfigureArgs = record {
  name : opt text;
  manifesto : opt text;
  welcome_message : opt text;
  open_registration : opt bool;
  quarter_join_mode : opt text;
};
type BrandingArgs = record { logo_url : opt text; background_image_url : opt text };
type TokensArgs = record { accounting_currency : opt text; accounting_currency_decimals : opt nat8 };
type TrustPolicyArgs = record {
  require_marketplace_approval : opt bool;
  trusted_approvers : opt vec text;
  trusted_principals : opt vec principal;
};
type RealmRegisterArgs = record { registry : principal; url : opt text; backend_url : opt text };
// Accepts exactly this module, if the trust policy does.
type RealmUpgradeArgs = record { version : text; module_hash : blob };

type SetupStep = variant {
  Realm : RealmConfigureArgs;
  Branding : BrandingArgs;
  Tokens : TokensArgs;
  TrustPolicy : TrustPolicyArgs;
};
type SetupState = record { status : RealmStatus; founder : opt principal; done : vec text; todo : vec text };

// §13

type ScopePage = record { items : vec text; next : opt text };

type AccessArgs = record { scope : text; cursor : opt text; limit : opt nat32 };
type PrincipalPage = record { items : vec principal; next : opt text };

type DocumentListArgs = record { department : text; cursor : opt text; limit : opt nat32 };
type DocumentPage = record { items : vec Document; next : opt text };

// The document's ciphertext reference, its key scope, and the caller's envelope if it has one.
type DocumentAccess = record { document : Document; scope : text; envelope : opt KeyEnvelope };

type WrappedKey = record { "principal" : principal; wrapped_dek : blob };
// At most 500 keys or principals per call.
type KeyGrantArgs = record { scope : text; keys : vec WrappedKey };
type KeyRevokeArgs = record { scope : text; principals : vec principal };

// Stores a new document, or replaces `document`.
type DocumentStoreArgs = record {
  document : opt text;
  department : text;
  title : text;
  ref : text;
  hash : text;
  keys : vec WrappedKey;
};
type DocumentStored = record { document : Document; scope : text };
type DocumentShareArgs = record { document : text; keys : vec WrappedKey };
type DocumentRevokeArgs = record { document : text; principals : vec principal };
// Deletes the wrapped keys `limit` at a time (at most 500), then the document: call again until `deleted`.
type DocumentDeleteArgs = record { document : text; limit : opt nat32 };
type DocumentDeleted = record { revoked : nat; deleted : bool };
service : {
  icrc10_supported_standards : () -> (vec record { name : text; url : text }) query;

  // §2
  ggg_user_get : (principal) -> (variant { Ok : opt UserEntry; Err : GggError }) query;
  ggg_user_list : (ListArgs) -> (variant { Ok : UserPage; Err : GggError }) query;
  ggg_invite_list : (ListArgs) -> (variant { Ok : InvitePage; Err : GggError }) query;
  ggg_delegation_list : (DelegationListArgs) -> (variant { Ok : DelegationPage; Err : GggError }) query;
  ggg_delegable_operations : () -> (variant { Ok : vec DelegableOperation; Err : GggError }) query;
  ggg_realm_join : (JoinArgs) -> (variant { Ok : UserEntry; Err : GggError });
  ggg_profile_update : (ProfileUpdateArgs) -> (variant { Ok : User; Err : GggError });
  ggg_private_data_update : (blob) -> (variant { Ok : User; Err : GggError });
  ggg_user_add : (UserAddArgs) -> (variant { Ok : Governed; Err : GggError });
  ggg_user_import : (UserImportArgs) -> (variant { Ok : Governed; Err : GggError });
  ggg_user_edit : (UserEditArgs) -> (variant { Ok : User; Err : GggError });
  ggg_user_set_status : (UserSetStatusArgs) -> (variant { Ok : Governed; Err : GggError });
  ggg_user_remove : (UserRemoveArgs) -> (variant { Ok : Governed; Err : GggError });
  ggg_identity_submit : (IdentitySubmitArgs) -> (variant { Ok : Identity; Err : GggError });
  ggg_identity_review : (IdentityReviewArgs) -> (variant { Ok : Identity; Err : GggError });
  ggg_invite_create : (InviteCreateArgs) -> (variant { Ok : InviteCreated; Err : GggError });
  ggg_invite_revoke : (text) -> (variant { Ok : Invite; Err : GggError });
  ggg_profile_create : (ProfileCreateArgs) -> (variant { Ok : Governed; Err : GggError });
  ggg_profile_edit : (ProfileEditArgs) -> (variant { Ok : Governed; Err : GggError });
  ggg_role_assign : (RoleArgs) -> (variant { Ok : Governed; Err : GggError });
  ggg_role_revoke : (RoleArgs) -> (variant { Ok : Governed; Err : GggError });
  ggg_delegation_grant : (DelegationGrantArgs) -> (variant { Ok : Delegation; Err : GggError });
  ggg_delegation_accept : (text) -> (variant { Ok : Delegation; Err : GggError });
  ggg_delegation_revoke : (text) -> (variant { Ok : Delegation; Err : GggError });
  ggg_delegation_request : (DelegationRequestArgs) -> (variant { Ok : DelegationRequest; Err : GggError });
  ggg_delegation_request_decide : (DelegationDecideArgs) -> (variant { Ok : opt Delegation; Err : GggError });

  // §3
  ggg_department_get : (GetArgs) -> (variant { Ok : opt DepartmentDetail; Err : GggError }) query;
  ggg_department_list : (ListArgs) -> (variant { Ok : DepartmentPage; Err : GggError }) query;
  ggg_department_chart : (ChartArgs) -> (variant { Ok : Chart; Err : GggError }) query;
  ggg_organization_get : (GetArgs) -> (variant { Ok : opt OrganizationDetail; Err : GggError }) query;
  ggg_organization_list : (OrganizationListArgs) -> (variant { Ok : OrganizationPage; Err : GggError }) query;
  ggg_department_create : (DepartmentCreateArgs) -> (variant { Ok : Governed; Err : GggError });
  ggg_department_edit : (DepartmentEditArgs) -> (variant { Ok : Governed; Err : GggError });
  ggg_department_delete : (text) -> (variant { Ok : Governed; Err : GggError });
  ggg_department_set_policy : (DepartmentPolicyArgs) -> (variant { Ok : Governed; Err : GggError });
  ggg_position_create : (PositionCreateArgs) -> (variant { Ok : Governed; Err : GggError });
  ggg_position_edit : (PositionEditArgs) -> (variant { Ok : Governed; Err : GggError });
  ggg_position_close : (text) -> (variant { Ok : Governed; Err : GggError });
  ggg_appoint : (AppointArgs) -> (variant { Ok : Governed; Err : GggError });
  ggg_appoint_acting : (AppointArgs) -> (variant { Ok : Governed; Err : GggError });
  ggg_appointment_end : (text) -> (variant { Ok : Governed; Err : GggError });
  ggg_department_expel : (ExpelArgs) -> (variant { Ok : Governed; Err : GggError });
  ggg_authority_grant : (AuthorityGrantArgs) -> (variant { Ok : Governed; Err : GggError });
  ggg_authority_revoke : (text) -> (variant { Ok : Governed; Err : GggError });
  ggg_organization_register : (OrganizationRegisterArgs) -> (variant { Ok : Organization; Err : GggError });
  ggg_organization_edit : (OrganizationEditArgs) -> (variant { Ok : Organization; Err : GggError });
  ggg_representative_add : (RepresentativeAddArgs) -> (variant { Ok : Appointment; Err : GggError });
  ggg_representative_remove : (text) -> (variant { Ok : Appointment; Err : GggError });
  ggg_organization_set_status : (OrganizationStatusArgs) -> (variant { Ok : Governed; Err : GggError });

  // §4
  ggg_proposal_get : (GetArgs) -> (variant { Ok : opt ProposalDetail; Err : GggError }) query;
  ggg_proposal_list : (ProposalListArgs) -> (variant { Ok : ProposalPage; Err : GggError }) query;
  ggg_proposal_create : (ProposalCreateArgs) -> (variant { Ok : text; Err : GggError });
  ggg_proposal_vote : (ProposalVoteArgs) -> (variant { Ok : Vote; Err : GggError });
  ggg_proposal_withdraw : (ProposalWithdrawArgs) -> (variant { Ok : Proposal; Err : GggError });
  ggg_proposal_open : (text) -> (variant { Ok : Proposal; Err : GggError });
  ggg_proposal_finalize : (text) -> (variant { Ok : Proposal; Err : GggError });
  ggg_proposal_execute : (text) -> (variant { Ok : Proposal; Err : GggError });
  ggg_mandate_create : (MandateCreateArgs) -> (variant { Ok : Governed; Err : GggError });
  ggg_mandate_revoke : (MandateRevokeArgs) -> (variant { Ok : Governed; Err : GggError });
  ggg_mandate_assign_executor : (MandateExecutorArgs) -> (variant { Ok : Governed; Err : GggError });
  ggg_contract_create : (ContractCreateArgs) -> (variant { Ok : Contract; Err : GggError });
  ggg_contract_terminate : (text) -> (variant { Ok : Contract; Err : GggError });
  ggg_governance_update : (GovernanceUpdateArgs) -> (variant { Ok : Governed; Err : GggError });

  // §5
  ggg_treasury_view : (ListArgs) -> (variant { Ok : TreasuryView; Err : GggError }) query;
  ggg_ledger_view : (LedgerArgs) -> (variant { Ok : LedgerPage; Err : GggError }) query;
  ggg_report_view : (ReportArgs) -> (variant { Ok : ReportPage; Err : GggError }) query;
  ggg_treasury_configure : (TreasuryConfigureArgs) -> (variant { Ok : Governed; Err : GggError });
  ggg_token_register : (TokenRegisterArgs) -> (variant { Ok : Governed; Err : GggError });
  ggg_nft_token_register : (NFTTokenRegisterArgs) -> (variant { Ok : Governed; Err : GggError });
  ggg_transfer_create : (TransferCreateArgs) -> (variant { Ok : Governed; Err : GggError });
  ggg_transfer_revert : (TransferRevertArgs) -> (variant { Ok : Governed; Err : GggError });
  ggg_invoice_create : (InvoiceCreateArgs) -> (variant { Ok : InvoiceCreated; Err : GggError });
  ggg_invoice_check : (InvoiceCheckArgs) -> (variant { Ok : Invoice; Err : GggError });
  ggg_invoice_refresh : (InvoiceRefreshArgs) -> (variant { Ok : InvoicePage; Err : GggError });
  ggg_fund_create : (FundCreateArgs) -> (variant { Ok : Governed; Err : GggError });
  ggg_period_open : (PeriodOpenArgs) -> (variant { Ok : Governed; Err : GggError });
  ggg_period_close : (text) -> (variant { Ok : Governed; Err : GggError });
  ggg_budget_draft : (BudgetDraftArgs) -> (variant { Ok : Governed; Err : GggError });
  ggg_budget_propose : (text) -> (variant { Ok : Governed; Err : GggError });
  ggg_budget_amend : (BudgetAmendArgs) -> (variant { Ok : Governed; Err : GggError });
  ggg_allocation_rule_draft : (AllocationRuleDraftArgs) -> (variant { Ok : Governed; Err : GggError });
  ggg_allocation_rule_propose : (text) -> (variant { Ok : Governed; Err : GggError });
  ggg_payroll_run : (PayrollRunArgs) -> (variant { Ok : Governed; Err : GggError });
  ggg_report_issue : (ReportIssueArgs) -> (variant { Ok : FinancialReport; Err : GggError });
  ggg_tax_policy_draft : (TaxPolicyDraftArgs) -> (variant { Ok : Governed; Err : GggError });
  ggg_tax_policy_propose : (text) -> (variant { Ok : Governed; Err : GggError });
  ggg_tax_assess : (TaxAssessArgs) -> (variant { Ok : TaxAssessPage; Err : GggError });
