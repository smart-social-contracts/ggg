// GGG 0.1.0: the GGG model in Candid.
// Model: https://github.com/smart-social-contracts/ggg/blob/main/model/README.md
//
// One record per model entity, with the model's fields, and one method per model operation.
// Every entity is here; the methods cover the operations bound so far.

// ---- Conventions (model §1)

// Nanoseconds since 1970-01-01 UTC, as returned by ic0.time.
type Timestamp = nat64;
// Nanoseconds.
type Duration = nat64;

// A count of calendar units: three months is three months, whatever the days. Deadlines and terms in
// legislation are Periods, never Durations. A WorkingDay is a day that is neither a weekend day nor a
// holiday in the realm's calendar, taken in the realm's time zone; GGG names the unit and the GOS
// counts it, failing closed when its calendar has no entries for a year the count reaches. Periods
// compare only within one unit: comparing two units fails closed, with no conversion through the
// calendar (model §1).
type PeriodUnit = variant { Day; WorkingDay; Month; Year };
type Period = record { count : nat; unit : PeriodUnit };

// A ratio in hundred-millionths: 100 % is 100 000 000, 1 % is 1 000 000 and 0.123456 % is 123 456.
// One scale for quorum, threshold, share, weight and tax rate (model §1). A Ratio is at most 100 %; a
// Rate, for tax rates and coefficients, which legislation takes above 100 %, is at most 100 times that.
type Ratio = nat;
type Rate = nat;
// Money in the token's smallest unit (Token.decimals). Money computed from a Ratio is rounded to the
// nearest cent, an exact half away from zero (model §1).
type Money = nat;
// Money that may be negative, such as a discount line of an invoice. Rounded as Money is.
type SignedMoney = int;
// An area in square metres.
type Area = nat;

// The ICRC-3 generic value, for structured data whose shape the model leaves open.
type Value = variant {
  Nat : nat;
  Int : int;
  Text : text;
  Blob : blob;
  Array : vec Value;
  Map : vec record { text; Value };
};

// A reference to any entity: `kind` is the entity's name in the model.
type Ref = record { kind : text; id : text };

type GggError = variant {
  NotFound;
  Unauthenticated;
  Forbidden : record { permission : opt text; message : text };
  InvalidArgument : text;
  Conflict : text;
  Unavailable : text;
  GenericError : record { error_code : nat; message : text };
};

// ---- §2 Identity and membership

type User = record {
  id : principal;
  nickname : opt text;
  avatar : opt text;
  home_quarter : opt text;
  // A BCP 47 language tag, for notices to the user.
  language : opt text;
  // The Zone the user lives in: a district the realm defined (zone_define), stated when joining or set by
  // user_edit.
  home_zone : opt text;
  profiles : vec text;
  private_data : opt blob;
};

type MemberStatus = variant { Active; Inactive; Suspended; Banned };

type Member = record {
  id : text;
  user : principal;
  status : MemberStatus;
  joined_at : opt Timestamp;
};

type GuestUser = record {
  id : principal;
  home_quarter : text;
  permissions : vec text;
};

type Human = record {
  id : text;
  user : principal;
  date_of_birth : opt Timestamp;
  h3_index : opt text;
};

type IdentityStatus = variant { Pending; Verified; Rejected };

// Standard kinds: `national_id`, `passport`, `residence_permit`, `driver_license`; a realm may add its own.
// The issuer of a national id or passport is the country, so it says the nationality.
type Identity = record {
  id : text;
  human : text;
  kind : text;
  // A subdivision of the kind, such as a long-term residence permit.
  category : opt text;
  issuer : text;
  ref : text;
  status : IdentityStatus;
  verified_at : opt Timestamp;
  expires_at : opt Timestamp;
};

type AttributeStatus = variant { Pending; Verified; Rejected };

// A certified attribute of a person: a status another body certifies and the realm verifies, as it
// verifies identities, such as a disability, a family status or being a student. The kinds and their
// values are legislation's; GGG records the attestation. `kind` and `value` are in clear, and readable
// only by the person, by the holders of attribute.review while it awaits review and by the codex
// (I-PRV-1); the audit log never holds them.
type Attribute = record {
  id : text;
  human : text;
  kind : text;
  value : text;
  issuer : text;
  ref : text;
  status : AttributeStatus;
  verified_at : opt Timestamp;
  expires_at : opt Timestamp;
};

type UserProfile = record {
  id : text;
  description : text;
  allowed_to : vec text;
  permissions : vec text;
};

type Permission = record {
  id : text;
  description : text;
  category : text;
  scope : opt text;
  users : vec principal;
  profiles : vec text;
  departments : vec text;
};

type Invite = record {
  id : text;
  profile : opt text;
  department : opt text;
  position : opt text;
  max_uses : nat;
  uses : nat;
  redeemed_by : vec principal;
  expires_at : opt Timestamp;
  revoked : bool;
  created_by : principal;
};

type DelegationStatus = variant { Pending; Active; Revoked; Expired; Declined };

type Delegation = record {
  id : text;
  grantor : principal;
  delegate : principal;
  scope : vec text;
  status : DelegationStatus;
  label : text;
  description : text;
  requires_acceptance : bool;
  granted_by : principal;
  accepted_at : opt Timestamp;
  starts_at : opt Timestamp;
  expires_at : Timestamp;
  revoked_at : opt Timestamp;
  revoked_by : opt principal;
};

type DelegationRequest = record {
  id : text;
  grantor : principal;
  delegate : principal;
  scope : vec text;
  label : text;
  description : text;
  starts_at : opt Timestamp;
  expires_at : Timestamp;
  request_expires_at : Timestamp;
};

// ---- §3 Departments and organizations

// m of n approvals.
type Policy = record { m : nat; n : nat; quorum : Ratio; veto : vec principal };

type Department = record {
  id : text;
  description : text;
  // What kind of body it is, such as the realm's plenary, so legislation from a source above can name the
  // kind without naming the department.
  kind : opt text;
  parent : opt text;
  is_root : bool;
  head : opt principal;
  policy : Policy;
  target_policy : opt Policy;
  fund : opt text;
};

type OrganizationStatus = variant { Active; Suspended; Dissolved };

type Organization = record {
  id : text;
  description : text;
  status : OrganizationStatus;
  admins : vec principal;
};

type PositionStatus = variant { Open; Frozen; Closed };

type Position = record {
  id : text;
  department : opt text;
  organization : opt text;
  title : text;
  profile : opt text;
  headcount : nat;
  salary : Money;
  salary_period : opt Duration;
  status : PositionStatus;
  inherit_from_capital : bool;
};

type AppointmentKind = variant { Substantive; Acting };
type AppointmentStatus = variant { Active; Ended };

type Appointment = record {
  id : text;
  position : text;
  user : principal;
  kind : AppointmentKind;
  agent : bool;
  supervisor : opt principal;
  started_at : Timestamp;
  ended_at : opt Timestamp;
  status : AppointmentStatus;
  source_quarter : opt text;
};

type Authority = record {
  id : text;
  grantor : text;
  target : Ref;
  operations : vec text;
};

// ---- §4 Governance

// ExecutionScheduled: accepted, and waiting for its effective_at.
type ProposalStatus = variant { Draft; Voting; Accepted; ExecutionScheduled; Rejected; Expired; Executed; Failed; Withdrawn };

type ProposalAction = variant {
  // The decision itself is the outcome.
  Motion;
  // One update call the realm makes to itself once accepted; `arg` is Candid-encoded.
  Call : record { method : text; arg : blob };
  // Codex code to adopt; checksum is "sha256:<hex>".
  Code : record { url : text; checksum : text };
};

type ProposalResult = variant {
  // The Candid-encoded reply of a Call.
  Reply : blob;
  // Why execution failed.
  Error : text;
};

// A link to another proposal. In Proposal.links it is the proposal's own link, fixed at creation. In
// ggg_proposal_linked_from it is another proposal's link to this one, so Replaces there reads
// "replaced by" and RelatesTo "related to". The proposal is the other proposal's id.
type ProposalLinkKind = variant { Replaces; RelatesTo };
type ProposalLink = record { kind : ProposalLinkKind; proposal : text };

// What a threshold is measured against: the yes and no votes cast, or the eligible voters; for a
// department, Eligible means its policy's n (`tally.seats`), and Cast is weaker and refused.
type ThresholdBasis = variant { Cast; Eligible };

// `eligible`: who may vote, counted when the vote opens. `seats`: a department's policy n, what its
// threshold is measured against (I-GOV-3); absent for a realm-wide proposal.
type Tally = record { yes : nat; no : nat; abstain : nat; eligible : opt nat; seats : opt nat };

type Proposal = record {
  id : text;
  title : text;
  description : text;
  proposer : principal;
  on_behalf_of : opt principal;
  // The delegate that prepared the call, when the proposer approved it from a pending action (§2).
  prepared_by : opt principal;
  department : opt text;
  // What the proposal is (a change of legislation, a budget, a motion) and the matter it decides, in the
  // realm's own words, for legislation to read.
  kind : opt text;
  matter : opt text;
  action : ProposalAction;
  status : ProposalStatus;
  opens_at : opt Timestamp;
  deadline : opt Timestamp;
  // When the action takes effect; absent means on acceptance. Fixed at creation, it never moves.
  effective_at : opt Timestamp;
  // The rule that decides it (I-GOV-3), fixed when the vote opens: the yes votes exceed (realm-wide)
  // or reach (a department, of `tally.seats`) the threshold of the basis, with the quorum met.
  threshold : Ratio;
  quorum : Ratio;
  threshold_of : ThresholdBasis;
  // The realm's casting vote when the proposal was created: a member whose yes decides a tie under the
  // Cast basis, so only a realm-wide proposal has one. Never the proposer's choice.
  casting_vote : opt principal;
  tally : Tally;
  result : opt ProposalResult;
  links : vec ProposalLink;
};

type VoteChoice = variant { Yes; No; Abstain };

type Vote = record {
  id : text;
  proposal : text;
  voter : principal;
  cast_by : opt principal;
  choice : VoteChoice;
  cast_at : Timestamp;
};

type MandateStatus = variant { Active; Completed; Revoked; Expired };

type Mandate = record {
  id : text;
  title : text;
  scope : Value;
  max_value : opt Money;
  symbol : opt text;
  executor : opt text;
  proposal : opt text;
  status : MandateStatus;
  expires_at : opt Timestamp;
};

type ContractStatus = variant { Draft; Active; Fulfilled; Terminated; Disputed };

type Contract = record {
  id : text;
  title : text;
  parties : vec Ref;
  mandate : opt text;
  // What is contracted (works, supplies, services), by which procedure, and the tender it came from, which
  // gave it its kind and procedure.
  kind : opt text;
  procedure : opt text;
  tender : opt text;
  value : Money;
  symbol : text;
  terms_ref : text;
  terms_hash : text;
  status : ContractStatus;
  starts_at : opt Timestamp;
  ends_at : opt Timestamp;
};

// ---- §5 Finance

type TreasuryConfig = record {
  epoch : Duration;
  anchor_month : nat8;
  source_fund : text;
  auto_allocate : bool;
};

type Treasury = record {
  id : text;
  config : TreasuryConfig;
  // The sum of the active loans' `outstanding`.
  debt_outstanding : Money;
};

type Token = record {
  id : text;
  ledger : principal;
  indexer : opt principal;
  decimals : nat8;
  fee : Money;
};

type NFTToken = record {
  id : text;
  canister : principal;
  name : text;
  description : text;
  transferable : bool;
  required_license : opt text;
  supply_cap : opt nat;
  total_supply : nat;
};

type Balance = record { symbol : text; amount : Money };

type Fund = record {
  id : text;
  name : text;
  kind : text;
  department : opt text;
  balances : vec Balance;
  allocation_rule : opt text;
};

type FiscalPeriodStatus = variant { Open; Closed; Archived };

type FiscalPeriod = record {
  id : text;
  name : text;
  starts_at : Timestamp;
  ends_at : Timestamp;
  status : FiscalPeriodStatus;
  statements : Value;
  source_hash : text;
};

// Proposed: filed with a proposal, which adopts exactly these lines. Extended: copied, fund by fund,
// from the previous period's adopted budget by budget_extend, in force until an adopted budget of that
// fund replaces it.
type BudgetStatus = variant { Draft; Proposed; Adopted; Amended; Extended; Closed };
// Whether a line plans money coming in or going out; `category` is the realm's word for what.
type BudgetKind = variant { Revenue; Expense };

type Budget = record {
  id : text;
  fund : text;
  period : text;
  category : text;
  kind : BudgetKind;
  planned : Money;
  actual : Money;
  status : BudgetStatus;
  proposal : opt text;
};

// AllocationRule and TaxPolicy.
type AdoptionStatus = variant { Draft; Proposed; Adopted; Superseded };

type Allocation = record { fund : text; share : Ratio };

type AllocationRule = record {
  id : text;
  source_fund : text;
  rules : vec Allocation;
  status : AdoptionStatus;
  proposal : opt text;
};

type LedgerKind = variant { Asset; Liability; Equity; Revenue; Expense };

// At most one of the source references (transfer … appeal) is set.
type LedgerEntry = record {
  id : text;
  transaction : text;
  kind : LedgerKind;
  category : text;
  debit : Money;
  credit : Money;
  symbol : text;
  fund : opt text;
  period : opt text;
  transfer : opt text;
  invoice : opt text;
  user : opt principal;
  organization : opt text;
  contract : opt text;
  case : opt text;
  penalty : opt text;
  appeal : opt text;
  at : Timestamp;
  description : text;
};

type InvoiceStatus = variant { Pending; Paid; Overdue; Cancelled };

// One line of an invoice. A negative amount is a discount or bonus. `quantity` is in the line's `unit`
// (`m3`, `h`, a count when absent). `legislation` is the provision that charges it.
type InvoiceItem = record {
  concept : text;
  amount : SignedMoney;
  quantity : opt nat;
  unit : opt text;
  legislation : opt text;
};

type Invoice = record {
  id : text;
  payer : Ref;
  amount : Money;
  // The items sum to `amount`. `facts` is what legislation reads about the invoice beyond its items.
  items : vec InvoiceItem;
  facts : Value;
  symbol : text;
  due_at : opt Timestamp;
  status : InvoiceStatus;
  reason : opt Ref;
  paid_at : opt Timestamp;
  payment : opt Value;
};

type TransferStatus = variant { Sending; Pending; Completed; Failed };

type Transfer = record {
  id : text;
  sender : Ref;
  to : Ref;
  symbol : text;
  amount : Money;
  ledger_tx : opt nat;
  invoice : opt text;
  status : TransferStatus;
  at : Timestamp;
  payroll : opt text;
};

type TradeStatus = variant { Pending; Completed; Failed };

type Trade = record {
  id : text;
  contract : opt text;
  leg_a : text;
  leg_b : text;
  status : TradeStatus;
};

type PaymentAccount = record {
  id : text;
  owner : Ref;
  network : text;
  address : text;
  symbol : text;
  label : text;
  verified : bool;
};

type FinancialReport = record {
  id : text;
  kind : text;
  period : text;
  as_of : Timestamp;
  statements : Value;
  source_hash : text;
  issued_by : principal;
  supersedes : opt text;
};

// One tax, fee or charge of a policy. `kind` is the realm's word (e.g. `tax`, `fee`, `surcharge`);
// `subject` names the entity each assessment walks (e.g. `Land`, `User`, `Organization`); `rate` or
// `amount` is what the entry charges when no codex computes it; `facts` is what legislation reads about
// the entry beyond these. A rule on tax_policy_propose or tax_policy_draft ranges over the policy's
// entries, one request per entry (layered-codex §3.2).
type TaxEntry = record {
  code : text;
  kind : text;
  subject : text;
  rate : opt Rate;
  amount : opt Money;
  facts : Value;
};

type TaxPolicy = record {
  id : text;
  status : AdoptionStatus;
  document : Value;
  description : text;
  proposal : opt text;
  adopted_at : opt Timestamp;
  taxes : vec TaxEntry;
};

type TaxDeclarationStatus = variant { Filed; Assessed; Settled; Disputed };

type LoanStatus = variant { Active; Repaid };

// Money the realm owes an outside lender, in the accounting currency (`symbol`), so that the treasury's
// `debt_outstanding` is one sum. The money itself moves outside the realm; GGG records the debt and its
// repayments.
type Loan = record {
  id : text;
  lender : text;
  amount : Money;
  symbol : text;
  term : Period;
  rate : Rate;
  fund : text;
  outstanding : Money;
  status : LoanStatus;
  facts : Value;
};

type TaxDeclaration = record {
  id : text;
  declarant : Ref;
  period : text;
  base : text;
  amount : Money;
  status : TaxDeclarationStatus;
  invoice : opt text;
};

// ---- §6 Assets

type LandStatus = variant { Active; Disputed; Revoked };

type Land = record {
  id : text;
  x : nat;
  y : nat;
  width : nat;
  height : nat;
  kind : text;
  // What an assessor set for taxes based on the parcel, its value in the accounting currency and its area
  // in square metres, when, and under which reference in the assessor's register.
  assessed_value : opt Money;
  area : opt Area;
  assessed_at : opt Timestamp;
  assessment_ref : opt text;
  owner : Ref;
  status : LandStatus;
  token_id : opt nat;
  registered_by : principal;
  metadata : Value;
};

// A member's own home cell (an h3 index, set with zone_set, tied to `user`), or a zone the realm defines
// with zone_define, such as a district, named by its id.
type Zone = record {
  id : text;
  name : text;
  kind : text;
  land : opt text;
  user : opt principal;
  metadata : Value;
  // Members whose home_zone this is.
  population : nat;
};

// ---- §7 Licensing

type LicenseStatus = variant { Applied; Active; Rejected; Suspended; Revoked; Expired };

type License = record {
  id : text;
  kind : text;
  holder : Ref;
  issued_by : text;
  status : LicenseStatus;
  applied_at : Timestamp;
  // When a decision is due, from the Procedure of the licence's kind.
  decision_due : opt Timestamp;
  issued_at : opt Timestamp;
  expires_at : opt Timestamp;
  evidence_ref : opt text;
  conditions : Value;
};

// What the realm's silence past a deadline means: Positive grants, Negative refuses.
type Silence = variant { Positive; Negative };

// How a kind of application is decided: who starts it, the deadline for a decision, and what the realm's
// silence means. Keyed by the licence kind it governs.
type Procedure = record {
  id : text;
  initiated_by : text;
  matter : opt text;
  decision_deadline : opt Period;
  silence : opt Silence;
  legislation : opt text;
  facts : Value;
};

type RequestStatus = variant { Filed; Decided };

// A request to the realm by a person or a body: a petition, a complaint, a request for information or
// for personal data. The kinds are the realm's; legislation sets the deadline and decides silence. A
// `body` or `reply` that holds personal data carries a Document reference, encrypted, not text in clear.
type Request = record {
  id : text;
  kind : text;
  by : Ref;
  body : Value;
  filed_at : Timestamp;
  due_at : opt Timestamp;
  extension_limit : opt Timestamp;
  status : RequestStatus;
  decision : opt text;
  reply : opt text;
  decided_at : opt Timestamp;
};

// ---- §8 Justice

type CourtLevel = variant { FirstInstance; Appellate; Supreme; Specialized };
type CourtStatus = variant { Active; Closed };

type Court = record {
  id : text;
  name : text;
  operator : Ref;
  level : CourtLevel;
  jurisdiction : text;
  parent : opt text;
  status : CourtStatus;
  license : opt text;
};

type JudgeStatus = variant { Active; Revoked };

type Judge = record {
  id : text;
  user : principal;
  court : text;
  specialization : text;
  status : JudgeStatus;
  appointed_at : Timestamp;
};

type DisputeStatus = variant { Filed; Accepted; Rejected; Withdrawn };

type Dispute = record {
  id : text;
  claimant : principal;
  respondent : Ref;
  subject : opt Ref;
  title : text;
  description_ref : opt text;
  status : DisputeStatus;
  case : opt text;
};

type CaseStatus = variant { Filed; Assigned; InProgress; VerdictIssued; Appealed; Closed; Dismissed; Transferred };

// Encrypted content: where it lives and its hash.
type Sealed = record { ref : text; hash : text };

type Case = record {
  id : text;
  court : text;
  plaintiff : Ref;
  defendant : Ref;
  judges : vec text;
  title : text;
  dispute : opt text;
  evidence : vec Sealed;
  status : CaseStatus;
  filed_at : Timestamp;
  closed_at : opt Timestamp;
};

type VerdictStatus = variant { Draft; Issued; Final; Overturned };

type Verdict = record {
  id : text;
  case : text;
  issued_by : text;
  decision : text;
  reasoning_ref : opt text;
  status : VerdictStatus;
  contract : opt text;
  issued_at : opt Timestamp;
};

type AppealStatus = variant { Filed; UnderReview; Granted; Denied; Withdrawn };

type Appeal = record {
  id : text;
  case : text;
  verdict : text;
  court : text;
  appellant : principal;
  grounds_ref : opt text;
  status : AppealStatus;
  decision : opt text;
  new_verdict : opt text;
};

type PenaltyKind = variant {
  Fine;
  Restitution;
  CommunityService;
  Suspension;
  Revocation;
  Injunction;
  Freeze;
  Termination;
};

type PenaltyStatus = variant { Pending; Executed; Waived };

type Penalty = record {
  id : text;
  verdict : text;
  target : Ref;
  kind : PenaltyKind;
  amount : opt Money;
  symbol : opt text;
  status : PenaltyStatus;
  due_at : opt Timestamp;
  executed_at : opt Timestamp;
  invoice : opt text;
};

// ---- §9 Procurement

type TenderStatus = variant { Draft; Open; Closed; Evaluation; Awarded; Contracted; Cancelled };

type Criterion = record { criterion : text; weight : Ratio };

// A notice of the tender published in a journal, recorded with tender_notice.
type Notice = record { journal : text; published_at : Timestamp; ref : opt text };

type Tender = record {
  id : text;
  title : text;
  description : text;
  requester : text;
  // What is tendered (works, supplies, services), by which procedure, and for how much.
  kind : opt text;
  procedure : opt text;
  estimated_value : opt Money;
  status : TenderStatus;
  opens_at : opt Timestamp;
  closes_at : opt Timestamp;
  rubric : vec Criterion;
  winner : opt text;
  contract : opt text;
  notices : vec Notice;
};

type Bid = record {
  id : text;
  tender : text;
  vendor : text;
  submitted_at : Timestamp;
  sealed : bool;
  payload_ref : text;
  payload_hash : text;
  price : opt Money;
  score : opt nat;
};

type BidScore = record {
  id : text;
  bid : text;
  evaluator : principal;
  criterion : text;
  score : nat;
  scored_at : Timestamp;
};

// ---- §10 Quarters and federation

type RealmStatus = variant { Setup; Alpha; Beta; Production; Deprecation; Terminated };

type Realm = record {
  id : text;
  name : text;
  manifesto : text;
  welcome_message : text;
  status : RealmStatus;
  calendar : opt text;
  treasury : opt text;
  accounting_currency : opt text;
  accounting_currency_decimals : opt nat8;
  is_quarter : bool;
  is_capital : bool;
  federation_realm_id : opt text;
  federation_codex : opt text;
  quarter_join_mode : opt text;
  // The realms this one syncs legislation from, each with its link status (I-NEST-1).
  sync_sources : vec SyncSource;
  trusted_principals : vec principal;
  require_marketplace_approval : bool;
  trusted_approvers : vec text;
  // For realm-wide proposals. `casting_vote` is an active member whose yes decides a tie over the votes
  // cast (I-GOV-3); set with governance_update.
  voting_threshold : Ratio;
  voting_quorum : Ratio;
  casting_vote : opt principal;
  open_registration : bool;
  logo_url : opt text;
  background_image_url : opt text;
  installed_version : text;
  network : text;
  // An IANA time zone name such as "Europe/Madrid"; "UTC" until the realm sets one.
  timezone : text;
  // BCP 47 tags of the realm's languages, the first the default.
  languages : vec text;
  // Its members; on a capital, with its quarters' as they last reported.
  member_count : nat;
};

type Cycle = record { name : text; every : Duration };

type Calendar = record {
  id : text;
  realm : text;
  epoch : Duration;
  fiscal_period : Duration;
  voting_window : Duration;
  codex_release_cycle : opt Duration;
  benefit_cycle : opt Duration;
  service_payment_cycle : opt Duration;
  license_review_cycle : opt Duration;
  custom_cycles : vec Cycle;
};

type Registry = record { id : text; description : text; principal_id : principal };

type QuarterStatus = variant { Setup; Active; Suspended; Splitting; Merging };

type Quarter = record {
  id : text;
  name : text;
  index : nat;
  status : QuarterStatus;
  population : nat;
  codex_id : opt text;
  codex_version : opt text;
  // The same flag as a follower's: a quarter not ready when its realm's codex switches is NonCompliant
  // until it installs.
  compliance : Compliance;
  last_sync : opt Timestamp;
  last_activity_at : opt Timestamp;
};

type Forward = record {
  id : text;
  subject : Ref;
  origin : text;
  destination : text;
  moved_at : Timestamp;
  signature : blob;
};

type FederalVoteStatus = variant { Open; Passed; Failed; Cancelled };

type FederalVote = record {
  id : text;
  title : text;
  origin_quarter : text;
  action : ProposalAction;
  rule : Value;
  hash : text;
  deadline : Timestamp;
  status : FederalVoteStatus;
  tally : Value;
};

type FederalVoteLegStatus = variant { Open; Reported };
type Outcome = variant { Passed; Failed };

type FederalVoteLeg = record {
  id : text;
  vote : text;
  quarter : text;
  proposal_id : opt text;
  outcome : opt Outcome;
  yes : nat;
  no : nat;
  abstain : nat;
  eligible : nat;
  status : FederalVoteLegStatus;
  hash : opt text;
};

type FederationMessage = record {
  id : text;
  topic : text;
  source : text;
  body : Value;
  response : opt Value;
};

// Links between realms: a realm takes legislation from the sync sources it chose by vote, each of
// which accepted it by vote (I-NEST-1).

// Requested: one side has voted. Active: both have. Ended: a side ended the link, `by` its capital.
type LinkStatus = variant { Requested; Active; Ended : record { by : principal; at : Timestamp } };
// A realm, by its capital, or a stand-in record at a public https URL for a source that runs no
// realm, pinned by the checksum of its content.
type SyncSourceRef = variant { Realm : principal; Record : record { url : text; checksum : text } };
type SyncSource = record { source : SyncSourceRef; name : text; status : LinkStatus };
// Compliant: every layer the realm runs is at least the latest release in effect in the source's
// record. NonCompliant since the date of the earliest release it misses, naming the `stale` layers by
// source id. Unknown: the record could not be read.
type Compliance = variant { Compliant; NonCompliant : record { since : Timestamp; stale : vec text }; Unknown };
// One layer a follower runs. It names no source: the sync source finds the layer by its checksum in
// its own record.
type ReportedLayer = record { version : text; checksum : text };
// On a sync source: a realm that syncs from it, `id` its capital as text, with its link status and
// its last report.
type Follower = record {
  id : text;
  capital : principal;
  status : LinkStatus;
  layers : vec ReportedLayer;
  compliance : Compliance;
  population : nat;
  reported_at : opt Timestamp;
};

// ---- §11 Codex, notifications and audit

// Pending: installed and checked, waiting for codex_activate or its proposal's effective_at.
type CodexStatus = variant { Pending; Active; Inactive; Reverted };

type Codex = record {
  id : text;
  version : text;
  checksum : text;
  status : CodexStatus;
  manifest : Value;
  capabilities : vec text;
  source : text;
  installed_at : Timestamp;
  previous : opt text;
};

type Notification = record {
  id : text;
  recipient : Ref;
  topic : text;
  title : text;
  body : text;
  href : opt text;
  sender : opt text;
  visibility : text;
  read_by : vec principal;
  at : Timestamp;
};

// A body outside the realm and outside the Internet Computer: an authority, a journal, a lender, a
// bank. `channel` is how a dispatch reaches it: `manual` (an operator delivers it) or an https URL (a
// bridge does).
type External = record {
  id : text;
  name : text;
  kind : text;
  channel : text;
};

type DispatchStatus = variant {
  Queued;
  // When it was delivered, and the receipt that proves it (a bulletin number, a filing reference).
  Confirmed : record { at : Timestamp; receipt : opt text };
  Failed : text;
};

// One notice to an External, queued by the realm and confirmed by whoever delivered it. `document` is
// the document it carries, `codex` the codex it concerns, when either applies. A `body` that holds
// personal data carries a Document reference, encrypted, not text in clear.
type Dispatch = record {
  id : text;
  to : text;
  topic : text;
  title : text;
  body : Value;
  document : opt text;
  codex : opt text;
  queued_at : Timestamp;
  status : DispatchStatus;
};

type TaskStatus = variant { Scheduled; Run; Failed; Cancelled };

// One operation scheduled for a time. It runs with the authority of whoever scheduled it, never as the
// realm's controller, and every guard and rule runs again when it does, so a task scheduled under old
// legislation obeys the legislation in force on its date. The run writes the operation's own Event, with
// origin `task`; `event` names it. There is no task_run operation.
type Task = record {
  id : text;
  op : text;
  args : Value;
  at : Timestamp;
  reason : opt text;
  status : TaskStatus;
  scheduled_by : Ref;
  event : opt text;
};

type Event = record {
  id : text;
  op : text;
  user : opt principal;
  by : opt principal;
  // The grant a delegated act ran under.
  grant : opt text;
  // The delegate that prepared the act, when the member approved it from a pending action (origin `confirmed`).
  prepared_by : opt principal;
  agent : bool;
  supervisor : opt principal;
  origin : text;
  args : Value;
  result : Value;
  at : Timestamp;
};

// ---- §13 Private content

type KeyEnvelope = record {
  id : text;
  scope : text;
  "principal" : principal;
  wrapped_dek : blob;
  granted_by : principal;
  at : Timestamp;
};

// A publication of the document in a journal: the dispatch that carried it, and when and under which
// reference the journal published it, from the dispatch's confirmation.
type Publication = record { journal : text; dispatch : text; published_at : opt Timestamp; ref : opt text };
// Content in clear: where it lives and its hash. It holds no personal data.
type Published = record { ref : text; hash : text };

type Document = record {
  id : text;
  department : text;
  title : text;
  // What the document is (minutes, an ordinance, an award), and the BCP 47 tags of its languages.
  kind : opt text;
  languages : vec text;
  ref : text;
  hash : text;
  author : principal;
  at : Timestamp;
  // What legislation reads about the document when it is shared, such as its source and whether it was
  // given freely.
  facts : Value;
  // Published to everyone: the content in clear, readable without signing in.
  public : opt Published;
  publications : vec Publication;
};

// ---- Operation arguments and results

type ListArgs = record { cursor : opt text; limit : opt nat32 };
// One record by id, with its children a page at a time.
type GetArgs = record { id : text; cursor : opt text; limit : opt nat32 };

// The change was applied, with the id of any record it created, or a proposal was filed to make it.
type Governed = variant { Done : opt text; Proposed : text };

// §2

type UserEntry = record { user : User; member : opt Member };
type UserPage = record { items : vec UserEntry; next : opt text };
type InvitePage = record { items : vec Invite; next : opt text };

type DelegationListArgs = record {
  role : variant { Grantor; Delegate };
  cursor : opt text;
  limit : opt nat32;
};
// The caller's delegations in that role, and its open requests either way.
type DelegationPage = record { items : vec Delegation; requests : vec DelegationRequest; next : opt text };

type DelegableOperation = record { operation : text; permission : text };

// An operation's tier under power of attorney (delegation.json): Direct runs at once under a grant that
// names its group, Confirm asks the grantor each time. `confirm_if` is the condition under which a Direct
// operation asks instead.
type DelegationTier = variant { Direct; Confirm };
type TieredOperation = record { operation : text; permission : text; tier : DelegationTier; confirm_if : opt text };
// One group a grant may name, as delegation.json defines it, with the caller's operations in it. `id` is
// the group's, or `office:<department>` and `orgs:<organization>` for a group with a parameter; `longest`
// is how long a grant of it may last; `confirms` says whether some of its operations ask each time.
type DelegationGroup = record {
  id : text;
  label : text;
  summary : text;
  risk : text;
  longest : Duration;
  confirms : bool;
  operations : vec TieredOperation;
};
type DelegationGroupPage = record { items : vec DelegationGroup; next : opt text };
type DelegationGroupsArgs = record { cursor : opt text; limit : opt nat32; on_behalf_of : opt principal };
// The events recorded under one grant, newest first, to its grantor or its delegate.
type DelegationActivityArgs = record { delegation : text; cursor : opt text; limit : opt nat32; on_behalf_of : opt principal };

// The caller, their permissions, and their open delegations. Private data is omitted when delegated.
type MeArgs = record { on_behalf_of : opt principal };
type Me = record {
  user : User;
  member : opt Member;
  permissions : vec text;
  delegations : vec Delegation;
  requests : vec DelegationRequest;
};

// `home_zone` names a zone the realm defined; an unknown zone, or a member's home cell, is InvalidArgument.
type JoinArgs = record { code : opt text; nickname : opt text; language : opt text; home_zone : opt text };
type ProfileUpdateArgs = record { nickname : opt text; avatar : opt text; language : opt text; on_behalf_of : opt principal };

type NewUser = record { user : principal; nickname : opt text };
type UserAddArgs = record { user : principal; nickname : opt text; department : opt text };
// At most 500 users per call. Nobody is added if one is already known or listed twice.
type UserImportArgs = record { users : vec NewUser; department : opt text };
type UserEditArgs = record {
  user : principal;
  nickname : opt text;
  avatar : opt text;
  home_quarter : opt text;
  language : opt text;
  // A zone the realm defined; an unknown zone, or a member's home cell, is InvalidArgument.
  home_zone : opt text;
};
type UserSetStatusArgs = record { user : principal; status : MemberStatus; department : opt text };
type UserRemoveArgs = record { user : principal; department : opt text };

type IdentitySubmitArgs = record {
  kind : text;
  category : opt text;
  issuer : opt text;
  ref : text;
  expires_at : opt Timestamp;
};
type IdentityReviewArgs = record { identity : text; status : variant { Verified; Rejected } };

// For the caller's own person. `ref` points to the proof, stored encrypted or off-chain.
type AttributeSubmitArgs = record {
  kind : text;
  value : text;
  issuer : opt text;
  ref : text;
  expires_at : opt Timestamp;
};
type AttributeReviewArgs = record { attribute : text; status : variant { Verified; Rejected } };
// The caller's own attributes, of one kind or all.
type AttributeListArgs = record { kind : opt text; cursor : opt text; limit : opt nat32; on_behalf_of : opt principal };
type AttributePage = record { items : vec Attribute; next : opt text };

type InviteCreateArgs = record {
  profile : opt text;
  department : opt text;
  position : opt text;
  code : opt text;
  max_uses : opt nat;
  expires_at : opt Timestamp;
};
// The code is returned only this once.
type InviteCreated = record { invite : Invite; code : text };

type ProfileCreateArgs = record { profile : text; description : text; allowed_to : vec text; department : opt text };
type ProfileEditArgs = record {
  profile : text;
  description : opt text;
  allowed_to : opt vec text;
  department : opt text;
};
type RoleArgs = record { user : principal; profile : text; department : opt text };

type DelegationGrantArgs = record {
  delegate : principal;
  scope : vec text;
  starts_at : opt Timestamp;
  expires_at : Timestamp;
  label : text;
  description : text;
};
type DelegationRequestArgs = record {
  grantor : principal;
  scope : vec text;
  starts_at : opt Timestamp;
  expires_at : Timestamp;
  label : text;
  description : text;
};
// Approving may narrow the scope or end the grant earlier.
type DelegationDecideArgs = record {
  request : text;
  approve : bool;
  scope : opt vec text;
  expires_at : opt Timestamp;
};
// Revokes every pending or active grant the caller gave, `limit` at a time: call again with `next` until
// it is absent. The member's own act: with `on_behalf_of` it is Forbidden.
type DelegationRevokeAllArgs = record { cursor : opt text; limit : opt nat32; on_behalf_of : opt principal };
type DelegationsRevoked = record { revoked : nat; next : opt text };

// Pending actions (model §2): a call in its confirm form, prepared by a delegate under a grant and waiting
// for the grantor's own approval.
type Call = record { method : text; arg : blob };
// Approved: a read the grantor approved, waiting for the delegate to collect it (ggg_action_collect).
type PendingActionStatus = variant { Pending; Approved; Approving; Done; Failed; Declined; Withdrawn; Expired; Void };
// One line of the realm's own description of the call.
type SummaryLine = record { label : text; value : text };
type PendingAction = record {
  id : text;
  grantor : principal;
  delegate : principal;
  grant : text;
  call : Call;
  summary : vec SummaryLine;
  risk : text;
  note : opt text;
  status : PendingActionStatus;
  // Seals the record: computed by the GOS, with sha256 or a stronger hash, over at least the realm, the
  // id, the call, the grantor, the delegate, the grant and the expiry; a client sends it back unchanged.
  hash : text;
  filed_at : Timestamp;
  expires_at : Timestamp;
  decided_at : opt Timestamp;
  // The reply of an approved update once it ran, Candid-encoded with the method's own type, without what
  // the event log strips: a secret it returns, such as an invite code, is in the approval's own reply alone.
  // An approved read stores nothing: the approval authorises one run, which the delegate collects with
  // ggg_action_collect.
  result : opt blob;
};
type PendingActionPage = record { items : vec PendingAction; next : opt text };
type ActionListArgs = record {
  role : variant { Grantor; Delegate };
  status : opt PendingActionStatus;
  cursor : opt text;
  limit : opt nat32;
};
// The grantor's own act: never under a grant, so `on_behalf_of` is refused.
type ActionApproveArgs = record { action : text; hash : text; on_behalf_of : opt principal };
type ActionDeclineArgs = record { action : text; on_behalf_of : opt principal };
// One call on a grantor's behalf: `arg` is Candid-encoded with the method's own argument type. A confirm
// operation files a pending action; a direct one runs, or files the proposal a governed call files.
type CallForArgs = record { method : text; arg : blob; on_behalf_of : principal; note : opt text };
type CallForReply = variant { Done : blob; Proposed : text; Pending : PendingAction };
type ReadForArgs = record { method : text; arg : blob; on_behalf_of : principal };

// §3

// A position and the appointments that hold it.
type Seat = record { position : Position; holders : vec Appointment };

type DepartmentDetail = record { department : Department; seats : vec Seat; next : opt text };
type DepartmentPage = record { items : vec Department; next : opt text };

type ChartArgs = record { department : opt text; cursor : opt text; limit : opt nat32 };
// One level of the chart: the department's totals, and its sub-departments a page at a time.
type Chart = record {
  department : Department;
  positions : nat;
  seats : nat;
  filled : nat;
  children : vec Department;
  next : opt text;
};

type OrganizationDetail = record { organization : Organization; seats : vec Seat; next : opt text };
type OrganizationListArgs = record { cursor : opt text; limit : opt nat32; status : opt OrganizationStatus };
type OrganizationPage = record { items : vec Organization; next : opt text };

type DepartmentCreateArgs = record { department : text; parent : opt text; description : text; kind : opt text };
// The parent is never the department itself or one of its sub-departments; the root has none.
type DepartmentEditArgs = record {
  department : text;
  description : opt text;
  kind : opt text;
  parent : opt text;
  head : opt variant { Set : principal; Clear };
};
type DepartmentPolicyArgs = record { department : text; policy : Policy };

type PositionCreateArgs = record {
  department : text;
  position : text;
  title : text;
  headcount : opt nat;
  salary : opt Money;
  salary_period : opt Duration;
  profile : opt text;
};
// Closing is position_close.
type PositionEditArgs = record {
  position : text;
  status : opt variant { Open; Frozen };
  headcount : opt nat;
  title : opt text;
  salary : opt Money;
  salary_period : opt Duration;
  profile : opt text;
};

// An agent needs a supervisor holding a non-agent seat in the same department or organization.
type AppointArgs = record { position : text; user : principal; agent : bool; supervisor : opt principal };
type ExpelArgs = record { department : text; user : principal };
type AuthorityGrantArgs = record { department : text; target : Ref; operations : vec text };

type OrganizationRegisterArgs = record { organization : text; description : text };
type OrganizationEditArgs = record { organization : text; description : opt text; admins : opt vec principal };
// Seats the user in the organization's position, creating the position if it is new.
type RepresentativeAddArgs = record {
  organization : text;
  position : text;
  user : principal;
  agent : bool;
  supervisor : opt principal;
  title : opt text;
  profile : opt text;
  headcount : opt nat;
};
type OrganizationStatusArgs = record { organization : text; status : OrganizationStatus };

// §4

// The proposal, its votes a page at a time, and the one proposal that replaces it, if any. The other
// links to it are in ggg_proposal_linked_from.
type ProposalDetail = record { proposal : Proposal; votes : vec Vote; next : opt text; replaced_by : opt text };

// The links of other proposals to one proposal, oldest first.
type ProposalLinkPage = record { items : vec ProposalLink; next : opt text };

type ProposalListArgs = record { cursor : opt text; limit : opt nat32; status : opt ProposalStatus };
type ProposalPage = record { items : vec Proposal; next : opt text };

// links is optional, and absent means none, so callers built before links existed keep working. At
// most 16 links, each naming an existing proposal once. A Replaces target must be a withdrawn
// proposal filed for the same member (on_behalf_of when set, else the proposer), and one that no
// other proposal replaces yet.
type ProposalCreateArgs = record {
  title : text;
  description : text;
  department : opt text;
  kind : opt text;
  matter : opt text;
  // Stricter than the realm's or the department's rule, never weaker (InvalidArgument): a higher threshold
  // or quorum, or Eligible where the default is Cast. The casting vote is the realm's, for a realm-wide
  // proposal only, not the proposer's.
  threshold : opt Ratio;
  quorum : opt Ratio;
  threshold_of : opt ThresholdBasis;
  action : ProposalAction;
  // Must lie after the time of the call, else InvalidArgument. Absent means the action executes on acceptance.
  effective_at : opt Timestamp;
  links : opt vec ProposalLink;
  on_behalf_of : opt principal;
};

type ProposalVoteArgs = record {
  proposal : text;
  choice : VoteChoice;
  on_behalf_of : opt principal;
};

type ProposalWithdrawArgs = record { proposal : text; on_behalf_of : opt principal };

// A replayed proposal records itself as the mandate's proposal.
type MandateCreateArgs = record {
  title : text;
  scope : Value;
  max_value : opt Money;
  symbol : opt text;
  executor : opt text;
  expires_at : opt Timestamp;
};
type MandateRevokeArgs = record { mandate : text };
type MandateExecutorArgs = record { mandate : text; executor : text };

type ContractCreateArgs = record {
  title : text;
  parties : vec Ref;
  mandate : opt text;
  kind : opt text;
  procedure : opt text;
  tender : opt text;
  value : Money;
  symbol : text;
  terms_ref : text;
  terms_hash : text;
  starts_at : opt Timestamp;
  ends_at : opt Timestamp;
};

// `casting_vote` names an active member, else InvalidArgument.
type GovernanceUpdateArgs = record {
  voting_window : opt Duration;
  voting_threshold : opt Ratio;
  voting_quorum : opt Ratio;
  casting_vote : opt variant { Set : principal; Clear };
};

// §5

// The treasury and its registered tokens, and its funds a page at a time.
type TreasuryView = record {
  treasury : opt Treasury;
  tokens : vec Token;
  nft_tokens : vec NFTToken;
  funds : vec Fund;
  next : opt text;
};

type LedgerArgs = record {
  cursor : opt text;
  limit : opt nat32;
  transaction : opt text;
  symbol : opt text;
  kind : opt LedgerKind;
  fund : opt text;
  period : opt text;
};
type LedgerPage = record { items : vec LedgerEntry; next : opt text };

// One report by id, or a page of reports.
type ReportArgs = record { id : opt text; cursor : opt text; limit : opt nat32 };
type ReportPage = record { items : vec FinancialReport; next : opt text };

// An ICRC-1 account.
type Account = record { owner : principal; subaccount : opt blob };

type TreasuryConfigureArgs = record {
  epoch : opt Duration;
  anchor_month : opt nat8;
  source_fund : opt text;
  auto_allocate : opt bool;
};
type TokenRegisterArgs = record {
  symbol : text;
  ledger : principal;
  indexer : opt principal;
  decimals : opt nat8;
  fee : opt nat;
};
type NFTTokenRegisterArgs = record {
  symbol : text;
  canister : principal;
  name : opt text;
  description : opt text;
  transferable : opt bool;
  required_license : opt text;
  supply_cap : opt nat;
};

// The fund must also cover the ledger fee. `symbol` defaults to the accounting currency. `category`
// never names `ledger_fee`, the fee's own entry, which the GOS books itself (InvalidArgument).
type TransferCreateArgs = record {
  fund : text;
  to : Ref;
  amount : Money;
  symbol : opt text;
  category : opt text;
  description : opt text;
  contract : opt text;
  on_behalf_of : opt principal;
};
type TransferRevertArgs = record { transfer : text; reason : opt text };

// At least one item, and the items sum to `amount` (InvalidArgument otherwise).
type InvoiceCreateArgs = record {
  payer : Ref;
  amount : Money;
  symbol : opt text;
  due_at : opt Timestamp;
  reason : opt Ref;
  items : vec InvoiceItem;
  facts : opt Value;
};
// Adds a line to a pending invoice and raises (or, for a negative amount, lowers) its amount by the
// line's; Conflict once the invoice is paid, overdue or cancelled, InvalidArgument below zero.
type InvoiceItemAddArgs = record { invoice : text; item : InvoiceItem };
// The invoice, and the account to pay it into.
type InvoiceCreated = record { invoice : Invoice; pay_to : Account };
type InvoiceCheckArgs = record { invoice : text; on_behalf_of : opt principal };
// One page of the caller's invoices, each with the account to pay it into.
type MyInvoicesArgs = record { cursor : opt text; limit : opt nat32; on_behalf_of : opt principal };
type MyInvoice = record { invoice : Invoice; pay_to : Account };
type MyInvoicePage = record { items : vec MyInvoice; next : opt text };
// One invoice, or a batch of the pending and overdue ones (at most 20 per call).
type InvoiceRefreshArgs = record { invoice : opt text; cursor : opt text; limit : opt nat32 };
type InvoicePage = record { items : vec Invoice; next : opt text };

// `department` is the fund's owner; a department owns at most one fund.
type FundCreateArgs = record { fund : text; name : opt text; kind : opt text; department : opt text };
// Periods open in order: one starts no earlier than the latest ends.
type PeriodOpenArgs = record { period : text; name : opt text; starts_at : Timestamp; ends_at : Timestamp };
// `category` never names `ledger_fee`, which the GOS books itself (InvalidArgument).
type BudgetDraftArgs = record { fund : text; period : text; category : text; kind : BudgetKind; planned : Money };
type BudgetAmendArgs = record { budget : text; planned : Money };
// Proposes the draft lines of the period together: those of `fund`, under its owner's policy, or every
// fund's, under the root's; they are `proposed` from the filing, by this call or by any proposal that
// carries it, the execution adopts exactly them, and a proposal that ends otherwise returns them to Draft.
// `years` is how many periods the plan covers, when more than one. Legislation reads the totals of the
// lines it proposes, `revenue` and `expense` (the sums of `planned` over their Revenue and Expense lines;
// `fund` tells the two forms apart), as facts of the call; a total out of Money's range is
// InvalidArgument, like any other fact.
type BudgetProposeArgs = record { period : text; years : opt nat; fund : opt text };
// Shares add up to at most 100 000 000 (100 %).
type AllocationRuleDraftArgs = record { source_fund : text; rules : vec Allocation };
// Pays each active, non-agent appointee once per period label.
type PayrollRunArgs = record { department : text; period : text; symbol : opt text };
// `adjustments` are figures the issuer adds to the ledger's, for a report in terms the ledger doesn't keep.
type ReportIssueArgs = record { period : text; kind : opt text; adjustments : opt Value };

// The entries are checked as they are when the policy is proposed (layered-codex §3.2).
type TaxPolicyDraftArgs = record { document : Value; description : opt text; taxes : vec TaxEntry };
// Bills one batch of taxpayers for the period; those already billed are skipped.
type TaxAssessArgs = record { period : text; tax : opt text; cursor : opt text; limit : opt nat32 };
type TaxAssessPage = record { items : vec Invoice; skipped : nat; next : opt text };
// For the caller, or an organization they administer.
type TaxDeclareArgs = record {
  base : text;
  period : text;
  amount : Money;
  organization : opt text;
  on_behalf_of : opt principal;
};
type TaxDeclared = record { declaration : TaxDeclaration; invoice : opt Invoice };

// `lender` is an External; the loan is in the accounting currency. Governed by the root department.
type LoanCreateArgs = record {
  lender : text;
  amount : Money;
  term : Period;
  rate : Rate;
  fund : text;
  facts : opt Value;
};
type LoanRepayArgs = record { loan : text; amount : Money; reason : opt text };
type LoanListArgs = record { cursor : opt text; limit : opt nat32; status : opt LoanStatus };
type LoanPage = record { items : vec Loan; next : opt text };

type PaymentAccountAddArgs = record {
  network : text;
  address : text;
  symbol : opt text;
  label : opt text;
  organization : opt text;
};
type PaymentAccountRemoveArgs = record { account : text; organization : opt text };

// By court order.
type ForceTransferArgs = record { symbol : text; from : principal; to : principal; amount : Money; reason : opt text };
type FreezeArgs = record { symbol : text; account : principal; frozen : bool; reason : opt text };

// §6

type LandListArgs = record { cursor : opt text; limit : opt nat32; owner : opt Ref };
type LandPage = record { items : vec Land; next : opt text };

// A viewport of at most 32 × 32 cells, and the zones not tied to a parcel a page at a time.
type LandMapArgs = record { x : nat; y : nat; w : nat; h : nat; cursor : opt text; limit : opt nat32 };
type LandMap = record { parcels : vec Land; zones : vec Zone; next : opt text };

// The token's ggg: header as read from the ledger, and its frozen flag.
type CredentialVerifyArgs = record { header : vec record { text; text }; frozen : bool };
type CredentialCheck = record { valid : bool; ours : bool; licensed : bool; expired : bool; revoked : bool };

// At most 16 × 16 cells, overlapping no other parcel.
type LandRegisterArgs = record {
  x : nat;
  y : nat;
  width : opt nat;
  height : opt nat;
  owner : Ref;
  kind : opt text;
  metadata : opt Value;
};
// Under a court order: an issued or final verdict in a case about the parcel, with `to` a party.
type LandTransferArgs = record { land : text; to : Ref; order : text };
type LandMintArgs = record { land : text; prepared_by : opt principal };
// What the assessor sets, signing for it; a field left absent keeps its value. `legislation` is the
// provision the assessment follows.
type LandAssessArgs = record {
  land : text;
  value : opt Money;
  area : opt Area;
  reference : opt text;
  legislation : opt text;
};
type LandFreezeArgs = record { land : text; reason : opt text };

// Defines a zone of the realm, such as a district, which members name as their home_zone; the same id
// again redefines it.
type ZoneDefineArgs = record { zone : text; name : text; kind : text };
// An h3 cell as the caller's home; it replaces the previous one.
type ZoneSetArgs = record { zone : text; name : opt text; kind : opt text; on_behalf_of : opt principal };
type ZoneClearArgs = record { zone : text; on_behalf_of : opt principal };

type CredentialIssueArgs = record {
  schema : text;
  holder : principal;
  organization : text;
  subject : opt text;
  fields : vec record { text; text };
  payload_hash : opt text;
  payload_ref : opt text;
  prepared_by : opt principal;
  expires_at : opt Timestamp;
};
type CredentialIssued = record { token_id : nat; header : vec record { text; text } };
type CredentialRevokeArgs = record { schema : text; token_id : nat; organization : text; reason : text };

// §7

type LicenseListArgs = record {
  cursor : opt text;
  limit : opt nat32;
  holder : opt Ref;
  kind : opt text;
  status : opt LicenseStatus;
};
type LicensePage = record { items : vec License; next : opt text };

// A licence by id, or the one of `kind` that `holder` holds.
type LicenseVerifyArgs = record { id : opt text; holder : opt Ref; kind : opt text };
type LicenseCheck = record { valid : bool; license : opt License };

// Defines, or redefines, the procedure of licences of `kind`.
type ProcedureDefineArgs = record {
  kind : text;
  initiated_by : text;
  matter : opt text;
  decision_deadline : opt Period;
  silence : opt Silence;
  legislation : opt text;
  facts : opt Value;
};
type ProcedurePage = record { items : vec Procedure; next : opt text };

// For the caller, or an organization they administer.
type RequestFileArgs = record { kind : text; body : Value; organization : opt text; on_behalf_of : opt principal };
type RequestGetArgs = record { id : text; on_behalf_of : opt principal };
type RequestListArgs = record { cursor : opt text; limit : opt nat32; kind : opt text; status : opt RequestStatus };
type RequestPage = record { items : vec Request; next : opt text };
// Sets or moves the deadline, never past `extension_limit`, which is set once (Conflict after that).
type RequestSetDueArgs = record { request : text; due_at : Timestamp; extension_limit : opt Timestamp };
// `decision` is the realm's word for the outcome (`granted`, `refused`, `refused_by_silence`).
type RequestDecideArgs = record { request : text; decision : text; reply : opt text };

// For the caller, or an organization they administer.
type LicenseApplyArgs = record {
  kind : text;
  holder : opt Ref;
  department : opt text;
  evidence_ref : opt text;
  conditions : opt Value;
  on_behalf_of : opt principal;
};
type LicenseRenewArgs = record { license : text; evidence_ref : opt text; on_behalf_of : opt principal };
type LicenseDecideArgs = record {
  license : text;
  approve : bool;
  department : opt text;
  expires_at : opt Timestamp;
  conditions : opt Value;
};
// With `resume`, reinstates a suspended licence.
type LicenseSuspendArgs = record { license : text; resume : bool };

// §8

type DisputeGetArgs = record { id : text; on_behalf_of : opt principal };
type DisputeListArgs = record { cursor : opt text; limit : opt nat32; status : opt DisputeStatus };
type DisputePage = record { items : vec Dispute; next : opt text };

// Verdicts past draft, newest first.
type ResolutionQueryArgs = record {
  cursor : opt text;
  limit : opt nat32;
  since : opt Timestamp;
  court : opt text;
  search : opt text;
};
type Resolution = record { verdict : Verdict; penalties : vec Penalty };
type ResolutionPage = record { items : vec Resolution; next : opt text };

type DisputeFileArgs = record {
  title : text;
  respondent : Ref;
  subject : opt Ref;
  description_ref : opt text;
  on_behalf_of : opt principal;
};
type DisputeWithdrawArgs = record { dispute : text; on_behalf_of : opt principal };
type DisputeAcceptArgs = record { dispute : text; court : text };
type CaseAssignArgs = record { case : text; judge : text };
type EvidenceSubmitArgs = record { case : text; ref : text; hash : text; on_behalf_of : opt principal };
type EvidenceEvaluateArgs = record { case : text; evidence : text; admitted : bool };

type PenaltyTerms = record {
  kind : PenaltyKind;
  target : Ref;
  amount : opt Money;
  symbol : opt text;
  due_at : opt Timestamp;
};
type VerdictDraftArgs = record { case : text; decision : text; reasoning_ref : opt text; penalties : vec PenaltyTerms };
type VerdictContractArgs = record { verdict : text; contract : text };
// New penalties replace them all. Changing an issued verdict restarts its appeal window.
type VerdictTermsArgs = record {
  verdict : text;
  decision : opt text;
  reasoning_ref : opt text;
  penalties : opt vec PenaltyTerms;
};
// `court` defaults to the issuing court's parent, and must rank above it.
type AppealFileArgs = record { verdict : text; court : opt text; grounds_ref : opt text; on_behalf_of : opt principal };
// Granting issues a new verdict that overturns the appealed one.
type AppealDecideArgs = record {
  appeal : text;
  granted : bool;
  decision : opt text;
  reasoning_ref : opt text;
  penalties : vec PenaltyTerms;
};
type PenaltyExecuteArgs = record { penalty : text; due_at : opt Timestamp };
type EnforcementArgs = record { verdict : text; note : text };
type EnforcementNotifyArgs = record { verdict : text; to : Ref; title : opt text; body : opt text };

// `operator` is a department, or an organization holding an active court licence.
type CourtCreateArgs = record {
  name : text;
  operator : Ref;
  level : opt CourtLevel;
  jurisdiction : opt text;
  parent : opt text;
};
type JudgeAppointArgs = record { court : text; user : principal; specialization : opt text };

// §9

type TenderListArgs = record { cursor : opt text; limit : opt nat32; status : opt TenderStatus };
type TenderPage = record { items : vec Tender; next : opt text };
// A sealed bid shows no price or score.
type TenderDetail = record { tender : Tender; bids : vec Bid; next : opt text };

// Weights add up to 100 000 000 (100 %).
type TenderCreateArgs = record {
  requester : text;
  title : text;
  description : opt text;
  kind : opt text;
  procedure : opt text;
  estimated_value : opt Money;
  opens_at : opt Timestamp;
  closes_at : opt Timestamp;
  rubric : vec Criterion;
};
// For a vendor the caller represents. `payload_hash` is the sha256 of `price:nonce`.
type BidSubmitArgs = record {
  tender : text;
  vendor : text;
  payload_ref : text;
  payload_hash : text;
  on_behalf_of : opt principal;
};
type BidWithdrawArgs = record { bid : text; on_behalf_of : opt principal };
type BidOpening = record { bid : text; price : Money; nonce : text };
type BidsRevealArgs = record { tender : text; openings : vec BidOpening };
// Marks from 0 to 10 per rubric criterion; scoring again replaces the caller's marks.
type BidScoreArgs = record { bid : text; scores : vec record { criterion : text; score : nat } };
// `bid` defaults to the best-scored revealed bid; a lower-scored one needs a justification.
type TenderAwardArgs = record { tender : text; bid : opt text; justification : opt text };
// Records that a notice of the tender appeared in `journal`: an External of kind `journal`, or `realm` for
// the realm's own journal. `at` defaults to now and is never in the future.
type TenderNoticeArgs = record { tender : text; journal : text; ref : opt text; at : opt Timestamp };

// §10

// `zones` is filled by quarter_sync alone: the zones the realm defines, as zone_define takes them, for the quarter to
// define the same (the capital is where the realm's codex defines its districts). Null in quarter_directory.
type QuarterDirectory = record { capital : opt text; items : vec Quarter; next : opt text; zones : opt vec ZoneDefineArgs };
// The zone a joiner states as their home, which a codex may use to keep neighbours together; it places them and
// nothing else.
type JoinTargetsArgs = record { home_zone : opt text };
// The least-populated active quarter a new member joins, and every quarter that takes joins.
type JoinTargets = record { default : opt text; targets : vec text; mode : opt text };
// A quarter's report to the capital.
type QuarterReportArgs = record {
  population : nat;
  codex_id : opt text;
  codex_version : opt text;
  leg : opt FederalVoteLeg;
  // The zones its members live in, each a pair of the zone's id and how many members have it as their
  // home_zone. The capital keeps what the last report said for placing new members and shows it to no one:
  // no operation returns it, since a small count singles out a person.
  zones : opt vec record { text; nat };
};
type QuarterReport = record { quarter : text; drifting : bool };

type QuarterRegisterArgs = record { canister : principal; name : opt text };
type QuarterConfigureArgs = record {
  quarter : opt text;
  name : opt text;
  status : opt QuarterStatus;
  quarter_join_mode : opt text;
  federation_codex : opt text;
  rule : opt Value;
  // An IANA name, for the `quarter` named; any other text, or a `timezone` with no `quarter`, is InvalidArgument.
  timezone : opt text;
  // For the `quarter` named; a `welcome_message` with no `quarter` is InvalidArgument.
  welcome_message : opt text;
};
type JoinFederationArgs = record { capital : principal; name : opt text };
type ChangeQuarterArgs = record { quarter : text };
type FederalVoteProposeArgs = record { title : text; action : ProposalAction };
// To quarter `to`, or by default every active quarter.
type FederationMessageArgs = record { topic : text; body : Value; to : opt text };

type SyncSourceAddArgs = record { source : SyncSourceRef; name : text };
// A Record is the same source when its url is the same, whatever the checksum.
type SyncSourceRemoveArgs = record { source : SyncSourceRef };
type FollowerArgs = record { follower : principal };
// What a follower's capital reports to a sync source, its own claims: the layers it runs, its
// compliance against that source and its population. The source matches a layer by its checksum.
type FollowerReportArgs = record { layers : vec ReportedLayer; compliance : Compliance; population : nat };
type FollowerPage = record { items : vec Follower; next : opt text };
// What the caller is to the receiver: its sync source, or its follower.
type LinkSide = variant { SyncSource; Follower };
// From the capital at the other side of a link: the link's new status after the caller's vote.
type LinkNotifyArgs = record { side : LinkSide; status : LinkStatus };

// §11

type SigningPolicy = record {
  agents : vec text;
  delegable : vec text;
  supervision : variant { Required; Optional };
};

// The active codex and a page of earlier ones, each named by its checksum ("sha256:<hex>").
// No method returns a Codex record.
type CodexView = record {
  checksum : opt text;
  // A codex installed and waiting to be activated, by its checksum.
  pending : opt text;
  healthy : bool;
  signing : SigningPolicy;
  history : vec text;
  next : opt text;
};

type NotificationListArgs = record {
  recipient : opt Ref;
  unread : opt bool;
  cursor : opt text;
  limit : opt nat32;
  on_behalf_of : opt principal;
};
type NotificationPage = record { items : vec Notification; next : opt text };

// Newest first. An archive holds the events from `first` to `last`, and answers ggg_events for them.
type EventArchive = record { canister : principal; first : text; last : text };
type EventPage = record { items : vec Event; next : opt text; archives : vec EventArchive };

type CodexSource = variant {
  Package : record { manifest : Value; source : text };
  Registry : record { codex : text; version : text };
  // A release of a layer, found in the record of one of the realm's active sync sources.
  Release : record { source : text; version : text };
};

// A chapter of a release: the domain it writes and the checksum of its bytes.
type ChapterRef = record { domain : text; checksum : text };
// One release of one layer, as a published record lists it: every chapter of the source, changed or
// not, its calendar's checksum, the commit it was built from, when it was published and from when it
// is in force. `source` is the layer's source id, opaque text to GGG; `notes` are the publisher's, by
// language.
type Release = record {
  source : text;
  version : text;
  published : Timestamp;
  effective_from : Timestamp;
  commit : text;
  chapters : vec ChapterRef;
  calendar : opt text;
  notes : Value;
};
// One notification, or with `recipient` a page of that recipient's.
type NotificationReadArgs = record {
  notification : opt text;
  recipient : opt Ref;
  cursor : opt text;
  limit : opt nat32;
  on_behalf_of : opt principal;
};
type NotificationsRead = record { read : nat; next : opt text };
// A title and body in one language, for a notice sent in several.
type Translation = record { language : text; title : text; body : opt text };
// To a user, department or organization, a Notification; to an External, a Dispatch. With translations,
// each reader gets the one in their language, else the title and body given.
type NotificationSendArgs = record {
  recipient : Ref;
  title : text;
  body : opt text;
  href : opt text;
  topic : opt text;
  translations : opt vec Translation;
};
type Delivery = variant { Notification : Notification; Dispatch : Dispatch };

// A second external_add of the same id redefines the body.
type ExternalAddArgs = record { external : text; name : text; kind : text; channel : text };
type ExternalPage = record { items : vec External; next : opt text };
// A report that reached the realm from an External, entered by whoever received it, with the file as
// evidence. It is audited as an Event, which legislation hooks.
type ExternalReportArgs = record { external : text; topic : text; body : Value; evidence_ref : opt text };
// How the delivery went: Confirmed with when (`at` defaults to now, and lies between the dispatch's
// `queued_at` and now) and the receipt that proves it, or Failed with the reason.
type DispatchOutcome = variant { Confirmed : record { at : opt Timestamp; receipt : opt text }; Failed : text };
// A dispatch takes one outcome; a second is Conflict.
type DispatchConfirmArgs = record { dispatch : text; outcome : DispatchOutcome };
type DispatchListArgs = record { cursor : opt text; limit : opt nat32; to : opt text; status : opt variant { Queued; Confirmed; Failed } };
type DispatchPage = record { items : vec Dispatch; next : opt text };

// `codex` is the pending codex's checksum (at most one codex is pending at a time). `at` defaults to now;
// a time ahead schedules the activation.
type CodexActivateArgs = record { codex : text; at : opt Timestamp };
// The checksum of a codex in the realm's history to restore; absent means the one the active codex
// replaced.
type CodexRevertArgs = record { codex : opt text };
// A release of the realm's own layer. `published` is set by the realm when the publish applies.
type LegislationReleasePublishArgs = record {
  source : text;
  version : text;
  effective_from : Timestamp;
  commit : text;
  chapters : vec ChapterRef;
  calendar : opt text;
  notes : Value;
};
type ReleasePage = record { items : vec Release; next : opt text };

// `op` is an operation name (`user_set_status`), `args` its arguments as the Event records them.
type TaskScheduleArgs = record { op : text; args : Value; at : Timestamp; reason : opt text };
type TaskRescheduleArgs = record { task : text; at : Timestamp };
type TaskListArgs = record { cursor : opt text; limit : opt nat32; op : opt text; status : opt TaskStatus };
type TaskPage = record { items : vec Task; next : opt text };

// §12

type RealmConfigureArgs = record {
  name : opt text;
  manifesto : opt text;
  welcome_message : opt text;
  open_registration : opt bool;
  quarter_join_mode : opt text;
  // BCP 47 tags, the first the default.
  languages : opt vec text;
  // An IANA name; any other text is InvalidArgument.
  timezone : opt text;
};
type BrandingArgs = record { logo_url : opt text; background_image_url : opt text };
type TokensArgs = record { accounting_currency : opt text; accounting_currency_decimals : opt nat8 };
type TrustPolicyArgs = record {
  require_marketplace_approval : opt bool;
  trusted_approvers : opt vec text;
  trusted_principals : opt vec principal;
};
type RealmRegisterArgs = record { registry : principal; url : opt text; backend_url : opt text };
// Accepts exactly this module, if the trust policy does.
type RealmUpgradeArgs = record { version : text; module_hash : blob };

type SetupStep = variant {
  Realm : RealmConfigureArgs;
  Branding : BrandingArgs;
  Tokens : TokensArgs;
  TrustPolicy : TrustPolicyArgs;
};
type SetupState = record { status : RealmStatus; founder : opt principal; done : vec text; todo : vec text };
// What the platform that installs a realm (its host: an installer, a registry) tells it, once.
type HostInstallArgs = record {
  // Configures the realm until it launches.
  founder : principal;
  // Where it runs: "ic", "staging", "local".
  network : text;
  // The realm registry that lists it, if the host has one.
  registry : opt principal;
  // Whether test features may be turned on.
  test_mode : bool;
};
// The canisters a realm works with. Ones only some GOS use go in `extra`, named "<gos>:<role>"
// ("realms_gos:baton").
type HostInfrastructure = record {
  frontend : opt principal;
  file_registry : opt principal;
  extra : vec record { text; principal };
};

type Monitor = record {
  status : RealmStatus;
  installed_version : text;
  cycles : nat;
  memory : nat;
  events : nat;
};

// §13

type ScopePage = record { items : vec text; next : opt text };

type AccessArgs = record { scope : text; cursor : opt text; limit : opt nat32 };
type PrincipalPage = record { items : vec principal; next : opt text };

type DocumentListArgs = record {
  department : text;
  cursor : opt text;
  limit : opt nat32;
  kind : opt text;
  language : opt text;
};
type DocumentPage = record { items : vec Document; next : opt text };

// The document's ciphertext reference, its key scope, and the caller's envelope if it has one.
type DocumentAccess = record { document : Document; scope : text; envelope : opt KeyEnvelope };

type WrappedKey = record { "principal" : principal; wrapped_dek : blob };
// At most 500 keys or principals per call.
type KeyGrantArgs = record { scope : text; keys : vec WrappedKey };
type KeyRevokeArgs = record { scope : text; principals : vec principal };

// Stores a new document, or replaces `document`.
type DocumentStoreArgs = record {
  document : opt text;
  department : text;
  title : text;
  kind : opt text;
  languages : vec text;
  ref : text;
  hash : text;
  facts : opt Value;
  keys : vec WrappedKey;
};
type DocumentStored = record { document : Document; scope : text };
// On what basis personal data is shared: the legal basis and purpose in the realm's own words, the
// legislation that sets the duty or task, and whether the data is of a special category.
type ShareBasis = record { legal_basis : text; purpose : text; legislation : opt text; special_category : bool };
// `recipient` is whom the keys are for: a User, an Organization or an External. `facts` is what
// legislation reads about this share beyond the basis.
type DocumentShareArgs = record { document : text; recipient : Ref; basis : opt ShareBasis; facts : opt Value; keys : vec WrappedKey };
// Publishes the content in clear at `ref`, with its `hash`: the document becomes public. With an External
// journal in `to`, a Dispatch to it is queued too.
type DocumentPublishArgs = record { document : text; to : opt text; ref : text; hash : text };
type DocumentRevokeArgs = record { document : text; principals : vec principal };
// Deletes the wrapped keys `limit` at a time (at most 500), then the document: call again until `deleted`.
type DocumentDeleteArgs = record { document : text; limit : opt nat32 };
type DocumentDeleted = record { revoked : nat; deleted : bool };
service : {
  icrc10_supported_standards : () -> (vec record { name : text; url : text }) query;

  // §2
  ggg_user_get : (principal) -> (variant { Ok : opt UserEntry; Err : GggError }) query;
  ggg_user_list : (ListArgs) -> (variant { Ok : UserPage; Err : GggError }) query;
  ggg_invite_list : (ListArgs) -> (variant { Ok : InvitePage; Err : GggError }) query;
  ggg_delegation_list : (DelegationListArgs) -> (variant { Ok : DelegationPage; Err : GggError }) query;
  ggg_attribute_list : (AttributeListArgs) -> (variant { Ok : AttributePage; Err : GggError }) query;
  // The attributes awaiting review, for the holders of attribute.review (I-PRV-1); the cursor continues
  // after the last attribute returned, so deciding a page skips none.
  ggg_attribute_pending_list : (ListArgs) -> (variant { Ok : AttributePage; Err : GggError }) query;
  ggg_delegable_operations : () -> (variant { Ok : vec DelegableOperation; Err : GggError }) query;
  ggg_delegation_groups : (DelegationGroupsArgs) -> (variant { Ok : DelegationGroupPage; Err : GggError }) query;
  ggg_delegation_activity : (DelegationActivityArgs) -> (variant { Ok : EventPage; Err : GggError }) query;
  ggg_action_get : (text) -> (variant { Ok : opt PendingAction; Err : GggError }) query;
  ggg_action_list : (ActionListArgs) -> (variant { Ok : PendingActionPage; Err : GggError }) query;
  ggg_read_for : (ReadForArgs) -> (variant { Ok : blob; Err : GggError }) query;
  ggg_me : (MeArgs) -> (variant { Ok : Me; Err : GggError }) query;
  ggg_realm_join : (JoinArgs) -> (variant { Ok : UserEntry; Err : GggError });
  ggg_profile_update : (ProfileUpdateArgs) -> (variant { Ok : User; Err : GggError });
  ggg_private_data_update : (blob) -> (variant { Ok : User; Err : GggError });
  ggg_user_add : (UserAddArgs) -> (variant { Ok : Governed; Err : GggError });
  ggg_user_import : (UserImportArgs) -> (variant { Ok : Governed; Err : GggError });
  ggg_user_edit : (UserEditArgs) -> (variant { Ok : User; Err : GggError });
  ggg_user_set_status : (UserSetStatusArgs) -> (variant { Ok : Governed; Err : GggError });
  ggg_user_remove : (UserRemoveArgs) -> (variant { Ok : Governed; Err : GggError });
  ggg_identity_submit : (IdentitySubmitArgs) -> (variant { Ok : Identity; Err : GggError });
  ggg_identity_review : (IdentityReviewArgs) -> (variant { Ok : Identity; Err : GggError });
  ggg_attribute_submit : (AttributeSubmitArgs) -> (variant { Ok : Attribute; Err : GggError });
  ggg_attribute_review : (AttributeReviewArgs) -> (variant { Ok : Attribute; Err : GggError });
  ggg_invite_create : (InviteCreateArgs) -> (variant { Ok : InviteCreated; Err : GggError });
  ggg_invite_revoke : (text) -> (variant { Ok : Invite; Err : GggError });
  ggg_profile_create : (ProfileCreateArgs) -> (variant { Ok : Governed; Err : GggError });
  ggg_profile_edit : (ProfileEditArgs) -> (variant { Ok : Governed; Err : GggError });
  ggg_role_assign : (RoleArgs) -> (variant { Ok : Governed; Err : GggError });
  ggg_role_revoke : (RoleArgs) -> (variant { Ok : Governed; Err : GggError });
  ggg_delegation_grant : (DelegationGrantArgs) -> (variant { Ok : Delegation; Err : GggError });
  ggg_delegation_accept : (text) -> (variant { Ok : Delegation; Err : GggError });
  ggg_delegation_revoke : (text) -> (variant { Ok : Delegation; Err : GggError });
  ggg_delegation_request : (DelegationRequestArgs) -> (variant { Ok : DelegationRequest; Err : GggError });
  ggg_delegation_request_decide : (DelegationDecideArgs) -> (variant { Ok : opt Delegation; Err : GggError });
  ggg_delegation_revoke_all : (DelegationRevokeAllArgs) -> (variant { Ok : DelegationsRevoked; Err : GggError });
  ggg_action_approve : (ActionApproveArgs) -> (variant { Ok : PendingAction; Err : GggError });
  ggg_action_decline : (ActionDeclineArgs) -> (variant { Ok : PendingAction; Err : GggError });
  ggg_action_withdraw : (text) -> (variant { Ok : PendingAction; Err : GggError });
  // The delegate that prepared an approved read runs it once, as the grantor, at this moment, while the
  // grant is active and covers the group: the reply, Candid-encoded with the method's own type. A second
  // call is Conflict; so is one after expires_at (expired) or after the grant was revoked (void).
  ggg_action_collect : (text) -> (variant { Ok : blob; Err : GggError });
  ggg_call_for : (CallForArgs) -> (variant { Ok : CallForReply; Err : GggError });

