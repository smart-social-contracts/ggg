{
  "tiers": {
    "direct": "Runs at once under a grant that names the operation's group; the grantor is told afterwards.",
    "confirm": "Asks each time: the delegate prepares the exact call, and it runs only on the grantor's own approval of it.",
    "member": "Only the member, never under a grant and never prepared: approving or declining a prepared call, revoking every grant.",
    "founder": "Only the founder: opening the realm.",
    "none": "Needs no power of attorney: public reads, calls between canisters, the host's steps, a delegate acting as itself."
  },
  "groups": [
    {
      "id": "see",
      "label": "See my affairs and the realm",
      "summary": "Your card, your own notifications, invoices, disputes and grants; the realm's proposals, departments, budgets, tenders, land and codex; whatever else you can read. An office's inbox only under that office's group.",
      "risk": "Reads are not audited, so the realm cannot tell you one by one what your delegate looked at.",
      "longest": 31536000
    },
    {
      "id": "profile",
      "label": "Keep my profile up to date",
      "summary": "Nickname, avatar and home zone; marking notices read, never power-of-attorney notices.",
      "risk": "Your delegate decides how you appear to the realm.",
      "longest": 31536000
    },
    {
      "id": "vote",
      "label": "Vote for me",
      "summary": "Yes, no, abstain, and changing a vote; never on a proposal any of your delegates filed.",
      "risk": "Your delegate's vote counts as yours and cannot be told apart in the tally.",
      "longest": 31536000
    },
    {
      "id": "propose",
      "label": "Propose for me",
      "summary": "Motions, and withdrawing what it filed; a proposal that carries an action, and a federal vote, ask you each time.",
      "risk": "A motion is filed in your name; a proposal with an action waits for your approval.",
      "longest": 31536000
    },
    {
      "id": "filings",
      "label": "Applications, declarations and bids",
      "summary": "Tax declarations, licence applications, bids, registering an organisation, requests for information.",
      "risk": "A declaration binds you to what it declares, and a bid to its price.",
      "longest": 31536000
    },
    {
      "id": "justice",
      "label": "My disputes and appeals",
      "summary": "Filing and withdrawing disputes, submitting evidence, appealing.",
      "risk": "A dispute filed in your name makes you a party to it.",
      "longest": 31536000
    },
    {
      "id": "money",
      "label": "Payments from the realm's funds",
      "summary": "Transfers, payroll and reverting a transfer, always as proposals your delegate cannot vote on; recording a loan repayment; a contract under a mandate asks you each time.",
      "risk": "A transfer or a payroll run is a proposal the realm votes on but carries your name; a loan repayment is recorded at once.",
      "longest": 7776000
    },
    {
      "id": "payout",
      "label": "My payout accounts",
      "summary": "Adding or removing where the realm pays you; each asks you.",
      "risk": "Decides where your money goes, and the realm cannot pull a payment back.",
      "longest": 31536000
    },
    {
      "id": "identity",
      "label": "My identity proofs",
      "summary": "Submitting identity proofs and attributes; each asks you.",
      "risk": "A proof is your own statement of who you are.",
      "longest": 31536000
    },
    {
      "id": "keys",
      "label": "My keys and private data",
      "summary": "Sharing or taking back keys, and your encrypted vault, each asking you; reading your own envelopes is direct.",
      "risk": "A key handed over cannot be taken back: whoever holds it opens everything ever wrapped for you.",
      "longest": 31536000
    },
    {
      "id": "poa",
      "label": "Power of attorney",
      "summary": "Granting onward, accepting a grant and approving a request, each asking you; ending a grant is direct.",
      "risk": "Hands someone power to act for you, with no vote to follow.",
      "longest": 31536000
    },
    {
      "id": "membership",
      "label": "Joining and moving",
      "summary": "Joining with a code, moving to another quarter; each asks you.",
      "risk": "Moving ends your membership here; joining is your consent to the realm's terms.",
      "longest": 31536000
    },
    {
      "id": "office",
      "label": "Office work",
      "summary": "That office's clerical and preparatory work, its inbox and documents; sharing or deleting a document, and an invite that carries a profile or a seat, ask you.",
      "risk": "Acts in the name of the office you hold a seat in.",
      "longest": 31536000,
      "parameter": "department"
    },
    {
      "id": "sign",
      "label": "Sign acts of my office",
      "summary": "Verdicts, licence decisions, credentials, freezes, awards; every act waits for your own approval.",
      "risk": "You are personally accountable for every act you sign.",
      "longest": 31536000
    },
    {
      "id": "orgs",
      "label": "Organisations I run",
      "summary": "Editing the organisation, reading its inbox, removing representatives; seating someone, and changing its admins, ask you.",
      "risk": "Whoever is seated acts or signs for the organisation.",
      "longest": 31536000,
      "parameter": "organization"
    },
    {
      "id": "admin",
      "label": "Run the realm",
      "summary": "Governed administration as proposals; monitoring, tasks, the audit log; an upgrade approval asks you.",
      "risk": "Reaches the whole realm's records and settings.",
      "longest": 7776000
    },
    {
      "id": "setup",
      "label": "Set up my realm",
      "summary": "The whole setup wizard: settings, branding, tokens, the codex you picked, departments, seats, funds, voting rules, registration; appointments, roles and the steps that decide which code the realm trusts ask you. Ends at Launch.",
      "risk": "Takes effect at once while the realm is in setup; Launch stays yours.",
      "longest": 2592000
    }
  ],
  "everything": {
    "scope": "group:*",
    "summary": "Every group, including groups you gain later and operations a later release adds; preparing every act that asks you each time.",
    "warning": "Everything you can do in this realm, now and later, for up to 90 days. A few acts still ask you each time.",
    "longest": 7776000,
    "never": ["member", "founder"]
  },
  "conditions": {
    "with_action": "The proposal carries an action.",
    "profile_or_seat": "The invite carries a profile beyond member, or a seat.",
    "trust_step": "The step is the trust-policy step, which decides which code the realm trusts.",
    "head_or_veto_in_setup": "The realm is in setup, and the edit names the department's head or the policy names veto holders, which gives someone power without a vote.",
    "shares_keys": "The document is stored with keys for others.",
    "changes_admins": "The edit changes the organisation's admins.",
    "approves": "The request is approved; declining is direct.",
    "in_setup": "The realm is in setup, so the change takes effect without a vote."
  },
