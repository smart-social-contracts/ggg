// GGG-1: Realm core. Status: Draft.
// Specification: https://github.com/smart-social-contracts/ggg/blob/main/standards/GGG-1.md
// Model: https://github.com/smart-social-contracts/ggg/blob/main/model/README.md

// Nanoseconds since 1970-01-01 UTC, as returned by ic0.time.
type Timestamp = nat64;

// The ICRC-3 generic value.
type Value = variant {
  Nat : nat;
  Int : int;
  Text : text;
  Blob : blob;
  Array : vec Value;
  Map : vec record { text; Value };
};

type GggError = variant {
  NotFound;
  Unauthenticated;
  Forbidden : record { permission : opt text; message : text };
  InvalidArgument : text;
  Conflict : text;
  Unsupported : text;
  Unavailable : text;
  GenericError : record { error_code : nat; message : text };
};

type SupportedStandard = record { name : text; url : text };

type ListArgs = record {
  cursor : opt text;
  limit : opt nat32;
};

// realm_info

type Implementation = record {
  name : text;
  version : text;
  url : opt text;
};

type RealmStatus = variant {
  Setup;
  Alpha;
  Beta;
  Production;
  Deprecation;
  Terminated;
};

type Currency = record { symbol : text; decimals : nat8 };

type Realm = record {
  name : text;
  manifesto : text;
  welcome_message : text;
  status : RealmStatus;
  accounting_currency : opt Currency;
  logo_url : opt text;
  background_image_url : opt text;
  open_registration : bool;
  is_capital : bool;
  implementation : Implementation;
  member_count : opt nat;
};

// user_get, user_list

type MemberStatus = variant { Active; Inactive; Suspended; Banned };

type Member = record {
  id : principal;
  status : MemberStatus;
  joined_at : opt Timestamp;
  nickname : opt text;
  avatar : opt text;
  home_quarter : opt text;
  profiles : vec text;
};

type MemberPage = record { items : vec Member; next : opt text };

// proposal_get, proposal_list, proposal_create, proposal_vote

type ProposalStatus = variant {
  Draft;
  Voting;
  Accepted;
  Rejected;
  Expired;
  Executed;
  Failed;
  Withdrawn;
};

type ProposalAction = variant {
  // No action: the decision itself is the outcome.
  Motion;
  // A model operation, run once with these arguments when the proposal is accepted.
  Operation : record { op : text; args : Value };
  // Codex code to adopt, and its checksum ("sha256:<hex>").
  Code : record { url : text; checksum : text };
};

type Tally = record {
  yes : nat;
  no : nat;
  abstain : nat;
  eligible : opt nat;
};

type Proposal = record {
  id : text;
  title : text;
  description : text;
  proposer : principal;
  department : opt text;
  action : ProposalAction;
  status : ProposalStatus;
  opens_at : opt Timestamp;
  deadline : opt Timestamp;
  threshold_bps : nat;
  quorum_bps : nat;
  tally : Tally;
  result : opt Value;
};

type ProposalSummary = record {
  id : text;
  title : text;
  proposer : principal;
  department : opt text;
  status : ProposalStatus;
  deadline : opt Timestamp;
};

type ProposalListArgs = record {
  cursor : opt text;
  limit : opt nat32;
  status : opt ProposalStatus;
};

type ProposalPage = record { items : vec ProposalSummary; next : opt text };

type ProposalCreateArgs = record {
  title : text;
  description : text;
  department : opt text;
  action : ProposalAction;
  on_behalf_of : opt principal;
};

type VoteChoice = variant { Yes; No; Abstain };

type Vote = record {
  id : text;
  proposal_id : text;
  voter : principal;
  cast_by : opt principal;
  choice : VoteChoice;
  cast_at : Timestamp;
};

type ProposalVoteArgs = record {
  proposal_id : text;
  choice : VoteChoice;
  on_behalf_of : opt principal;
};

type ProposalVotesArgs = record {
  proposal_id : text;
  voter : opt principal;
  cursor : opt text;
  limit : opt nat32;
};

type VotePage = record { items : vec Vote; next : opt text };

type UserGetResult = variant { Ok : opt Member; Err : GggError };
type UserListResult = variant { Ok : MemberPage; Err : GggError };
type ProposalGetResult = variant { Ok : opt Proposal; Err : GggError };
type ProposalListResult = variant { Ok : ProposalPage; Err : GggError };
type ProposalVotesResult = variant { Ok : VotePage; Err : GggError };
type ProposalCreateResult = variant { Ok : text; Err : GggError };
type ProposalVoteResult = variant { Ok : Vote; Err : GggError };

service : {
  icrc10_supported_standards : () -> (vec SupportedStandard) query;

  ggg1_realm_info : () -> (Realm) query;

  ggg1_user_get : (principal) -> (UserGetResult) query;
  ggg1_user_list : (ListArgs) -> (UserListResult) query;

  ggg1_proposal_get : (text) -> (ProposalGetResult) query;
  ggg1_proposal_list : (ProposalListArgs) -> (ProposalListResult) query;
  ggg1_proposal_votes : (ProposalVotesArgs) -> (ProposalVotesResult) query;
  ggg1_proposal_create : (ProposalCreateArgs) -> (ProposalCreateResult);
  ggg1_proposal_vote : (ProposalVoteArgs) -> (ProposalVoteResult);
};
